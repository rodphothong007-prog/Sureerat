 (SM09D2)","brand":"Hytera","model":"SM09D2","sn":"","qty":"1"},{"no":"","name":"- Battery ขนาด 12V 50AH (TDB12-50)","brand":"Tranpower","model":"TDB12-50","sn":"","qty":"1"},{"no":"","name":"- Antenna Sinclair (Yagi)","brand":"Sinclair","model":"SY406-SF1SNF(ABK)","sn":"","qty":"1"},{"no":"6","name":"ชุดอุปกรณ์สถานีเครื่องวิทยุลูกข่ายชนิดมือถือ","brand":"","model":"","sn":"","qty":""},{"no":"6.1","name":"S/N เครื่องลูกข่ายชนิดมือถือ","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- แหล่งจ่ายไฟมาตรฐาน (PS16002)","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- ไมโครโฟนแบบตั้งโต๊ะ (SM10A1","brand":"","model":"","sn":"","qty":""},{"no":"6.2","name":"S/N เครื่องลูกข่ายชนิดมือถือ","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- แหล่งจ่ายไฟมาตรฐาน (PS16002)","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- ไมโครโฟนแบบตั้งโต๊ะ (SM10A1","brand":"","model":"","sn":"","qty":""},{"no":"7","name":"ชุดควบคุมสั่งการ Dispatcher","brand":"","model":"","sn":"","qty":""},{"no":"7.1","name":"- Dispatcher Client Computer (DELL Optiplex 7080MT)","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- Dispatcher Client Monitor (DELL P2219H)","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- อุปกรณ์สำรองไฟฟ้าขนาด 3 kVA (SYMDOME HE-3KS)","brand":"","model":"","sn":"","qty":""},{"no":"","name":"- อุปกรณ์ Switch Huawei (S5720-28p-SI)","brand":"","model":"","sn":"","qty":""}];

    let currentData = [...defaultData];
    let viewMode = 'GROUPED'; // 'GROUPED' or 'FLAT'
    let expandedSectionIds = new Set(); // Level 1 Section IDs
    let expandedSubGroupIds = new Set(); // Level 2 Sub-Group IDs
    let expandedVillageIds = new Set(); // Level 3 Village IDs
    let expandedDirectIds = new Set(); // Direct Items IDs
    const sectionSubFilter = {}; // key: Section ID ('sec-1'), value: SubGroup ID ('sub-1-1') or 'ALL'
    let chart1Instance = null;
    let chart2Instance = null;

    // Load Data on startup
    function initData() {
      const savedData = localStorage.getItem('shf_inventory_data');
      const savedSource = localStorage.getItem('shf_inventory_source');
      
      if (savedData) {
        try {
          const parsed = JSON.parse(savedData);
          if (Array.isArray(parsed) && parsed.length > 0) {
            currentData = parsed;
            updateSourceBadge(savedSource || 'ซิงค์ Google Sheets อัตโนมัติ');
          } else {
            currentData = [...defaultData];
            updateSourceBadge('ซิงค์ Google Sheets อัตโนมัติ');
          }
        } catch(e) {
          currentData = [...defaultData];
          updateSourceBadge('ซิงค์ Google Sheets อัตโนมัติ');
        }
      } else {
        currentData = [...defaultData];
        updateSourceBadge('ซิงค์ Google Sheets อัตโนมัติ');
      }
      refreshDashboard();
    }

    // Reset to default USO dataset
    function resetToDefaultData() {
      if (confirm('คุณต้องการรีเซ็ตข้อมูลทั้งหมดกลับเป็นค่าเริ่มต้น (USO Inventory) ใช่หรือไม่?')) {
        try {
          localStorage.removeItem('shf_inventory_data');
          localStorage.removeItem('shf_inventory_source');
        } catch(e) {}
        currentData = [...defaultData];
        updateSourceBadge('รายการบัญชีครุภัณฑ์ USO.xlsx');
        const select = document.getElementById('sectionFilterSelect');
        if (select) select.value = 'ALL';
        const toolbarSub = document.getElementById('subTopicToolbarSelect');
        if (toolbarSub) toolbarSub.value = 'ALL';
        for (const k in sectionSubFilter) delete sectionSubFilter[k];
        expandedSectionIds.clear();
        expandedSubGroupIds.clear();
        expandedVillageIds.clear();
        expandedDirectIds.clear();
        refreshDashboard();
        showToast('รีเซ็ตข้อมูลเป็นชุดเริ่มต้น (1,747 รายการ) เรียบร้อยแล้ว');
      }
    }

    // Refresh everything
    function refreshDashboard() {
      const groups = groupItemsIntoSets(currentData);
      populateSectionDropdown(groups);
      populateToolbarSubDropdown(groups);
      updateStatistics(groups);
      renderCurrentView(groups);
      updateCharts(groups);
    }

    // Populate Section Dropdown (หัวข้อ 1 ถึง 7)
    function populateSectionDropdown(groups) {
      const select = document.getElementById('sectionFilterSelect');
      if (!select) return;
      const currentVal = select.value || 'ALL';
      let totalAll = 0;
      groups.forEach(g => {
        totalAll += g.directItems.length;
        g.subGroups.forEach(sg => {
          totalAll += sg.items.length;
        });
      });

      let optionsHtml = `<option value="ALL">📋 ทุกหัวข้อ (1 ถึง ${groups.length}) - ทั้งหมด ${totalAll.toLocaleString()} รายการ</option>`;
      groups.forEach(g => {
        let itemCount = g.directItems.length;
        let vilCount = 0;
        g.subGroups.forEach(sg => {
          itemCount += sg.items.length;
          if (sg.villageUnits) vilCount += sg.villageUnits.length;
        });
        let titleText = g.title.replace(/^ชุดอุปกรณ์(ระบบ)?/, '').replace(/^ชุด/, '').trim();
        const vilText = vilCount > 0 ? ` (${vilCount} หมู่บ้าน / ${itemCount.toLocaleString()} รายการ)` : ` (${itemCount.toLocaleString()} รายการ)`;
        optionsHtml += `<option value="${g.no}">${g.no} ${titleText}${vilText}</option>`;
      });
      select.innerHTML = optionsHtml;
      if ([...select.options].some(o => o.value === currentVal)) {
        select.value = currentVal;
      } else {
        select.value = 'ALL';
      }
    }

    // Populate Toolbar Filter Dropdown (เลือกหมวดหมู่หรือหัวข้อย่อย)
    function populateToolbarSubDropdown(groups) {
      const select = document.getElementById('subTopicToolbarSelect');
      if (!select) return;
      const currentVal = select.value || 'ALL';

      let optionsHtml = `<option value="ALL">📂 แสดงทุกหมวดหมู่และหัวข้อย่อย</option>`;
      groups.forEach(g => {
        let secTitle = g.title.replace(/^ชุดอุปกรณ์(ระบบ)?/, '').replace(/^ชุด/, '').trim();
        
        let vilCount = 0;
        let totalSecItems = g.directItems.length;
        g.subGroups.forEach(sg => {
          totalSecItems += sg.items.length;
          if (sg.villageUnits) vilCount += sg.villageUnits.length;
        });
        const vilText = vilCount > 0 ? ` (${vilCount} หมู่บ้าน / ${totalSecItems.toLocaleString()} รายการ)` : ` (${totalSecItems.toLocaleString()} รายการ)`;

        if (g.subGroups && g.subGroups.length > 0) {
          optionsHtml += `<optgroup label="หมวด ${g.no}: ${secTitle}">`;
          optionsHtml += `<option value="SEC_${g.id}">📁 หมวด ${g.no} ทั้งหมด${vilText}</option>`;
          g.subGroups.forEach(sg => {
            const isVil = sg.villageUnits && sg.villageUnits.length > 0;
            const countText = isVil ? `${sg.villageUnits.length} หมู่บ้าน` : `${sg.items.length} รายการ`;
            let title = sg.title.replace(/^จังหวัด/, 'จ.').trim();
            optionsHtml += `<option value="${sg.id}">${sg.no} ${title} (${countText})</option>`;
          });
          optionsHtml += `</optgroup>`;
        } else {
          optionsHtml += `<option value="SEC_${g.id}">📁 หมวด ${g.no}: ${secTitle}${vilText}</option>`;
        }
      });

      select.innerHTML = optionsHtml;
      if ([...select.options].some(o => o.value === currentVal)) {
        select.value = currentVal;
      } else {
        select.value = 'ALL';
      }
    }

    // Handle Toolbar Filter change
    function handleToolbarSubFilter() {
      const select = document.getElementById('subTopicToolbarSelect');
      const selectedVal = select ? select.value : 'ALL';
      const groups = groupItemsIntoSets(currentData);

      if (selectedVal === 'ALL') {
        for (const k in sectionSubFilter) delete sectionSubFilter[k];
      } else if (selectedVal.startsWith('SEC_')) {
        const targetSecId = selectedVal.replace('SEC_', '');
        groups.forEach(g => {
          if (g.id === targetSecId) {
            sectionSubFilter[g.id] = 'ALL';
            expandedSectionIds.add(g.id);
            expandedDirectIds.add(g.id);
          } else {
            sectionSubFilter[g.id] = '__NONE__';
          }
        });
      } else {
        groups.forEach(g => {
          const found = g.subGroups && g.subGroups.some(sg => sg.id === selectedVal);
          if (found) {
            sectionSubFilter[g.id] = selectedVal;
            expandedSectionIds.add(g.id);
            expandedSubGroupIds.add(selectedVal);
          } else {
            sectionSubFilter[g.id] = '__NONE__';
          }
        });
      }
      renderCurrentView(groups);
    }

    // Handle Sub-group filter from within Section Card Header
    function handleSubGroupFilter(secId, subId) {
      sectionSubFilter[secId] = subId;
      if (subId && subId !== 'ALL') {
        expandedSectionIds.add(secId);
        expandedSubGroupIds.add(subId);
      }
      // Sync toolbar dropdown
      const toolbarSub = document.getElementById('subTopicToolbarSelect');
      if (toolbarSub) {
        if ([...toolbarSub.options].some(o => o.value === subId)) {
          toolbarSub.value = subId;
        } else if (subId === 'ALL') {
          toolbarSub.value = 'ALL';
        }
      }
      const groups = groupItemsIntoSets(currentData);
      renderCurrentView(groups);
    }

    // Handle Dropdown Change for Section Filter (1 ถึง 7)
    function handleSectionFilter() {
      const select = document.getElementById('sectionFilterSelect');
      const selectedSec = select ? select.value : 'ALL';
      const groups = groupItemsIntoSets(currentData);

      // Reset active sub-filters
      for (const k in sectionSubFilter) delete sectionSubFilter[k];

      if (selectedSec !== 'ALL') {
        const targetGroup = groups.find(g => String(g.no) === String(selectedSec));
        if (targetGroup) {
          expandedSectionIds.add(targetGroup.id);
          expandedDirectIds.add(targetGroup.id);
        }
      }
      populateToolbarSubDropdown(groups);
      renderCurrentView(groups);
    }

    // ==========================================
    // 2. INTELLIGENT 3-TIER HIERARCHY GROUPING ALGORITHM
    // ==========================================
    // Level 1: Main Category / Cabinet / Section (หัวข้อหลัก)
    // Level 2: Sub-Group / Station / Control Set / Province (หัวข้อรอง)
    // Level 3: Village / Sub-unit (หมู่บ้าน / จุดติดตั้ง)
    // Level 4: Equipment Items (รายการอุปกรณ์ย่อย)
    function groupItemsIntoSets(items) {
      const groups = [];
      let currentL1 = null;
      let currentL2 = null;
      let currentVillage = null;
      let currentSubCat = "";

      items.forEach((item, index) => {
        const rawName = String(item.name || '').trim();
        const rawNo = String(item.no || item.rawNo || '').trim();
        const cleanName = rawName.replace(/^[-*•↳\s]+/, '').replace(/#/g, '').trim();
        const startsWithBullet = rawName.startsWith('-') || 
                                 rawName.startsWith('*') || 
                                 rawName.startsWith('•') || 
                                 rawName.startsWith('↳') ||
                                 item.isSubItem === true;

        // 1. Detect Level 1: Main Category / Cabinet / Section (หัวข้อหลัก)
        // e.g. "1", "2", "3" (pure integer, no dot), or matches "รายการอุปกรณ์ในตู้ระบบ...", "ตู้ระบบ...", "ชุดสถานี..."
        let isL1 = false;
        if (!startsWithBullet) {
          if (/^[0-9]+$/.test(rawNo)) {
            isL1 = true;
          } else if (/^(รายการอุปกรณ์ในตู้ระบบ|ชุดสถานี|ตู้ระบบ|ชุดควบคุมสั่งการ)/.test(rawName) && !rawNo.includes('.')) {
            isL1 = true;
          } else if (rawName.startsWith('สถานีแม่ข่ายแบบ 1 Carrier - ') && !rawNo.includes('.')) {
            isL1 = true;
          }
        }

        if (isL1) {
          currentL1 = {
            id: 'sec-' + (groups.length + 1),
            index: groups.length + 1,
            no: rawNo || String(groups.length + 1),
            title: rawName.replace(/#/g, '').trim(),
            rawItem: item,
            brand: item.brand || 'Hytera',
            model: item.model || '',
            sn: item.sn || '',
            subGroups: [],
            directItems: []
          };
          item.sectionNo = String(currentL1.no);
          groups.push(currentL1);
          currentL2 = null;
          currentVillage = null;
          currentSubCat = "";
          return;
        }

        // 2. Detect Level 2: Sub-group / Station / Control Set / Province (หัวข้อรอง)
        // e.g. "1.1", "1.2", "3.1", "4.1", "5.1", or "S/N ชุดควบคุม...", "ชุดควบคุมสถานีแม่ข่าย IPN", "ที่ว่าการอำเภอ...", "BS ", "จังหวัด"
        let isL2 = false;
        if (!startsWithBullet) {
          if (/^[0-9]+\.[0-9]+$/.test(rawNo)) {
            isL2 = true;
          } else if (/^(S\/N ชุดควบคุม|ชุดควบคุม|ที่ว่าการอำเภอ|BS\s|จังหวัด)/i.test(rawName) && !/^[0-9]+\.[0-9]+\.[0-9]+/.test(rawNo)) {
            isL2 = true;
          }
        }

        if (isL2) {
          if (!currentL1) {
            currentL1 = {
              id: 'sec-' + (groups.length + 1),
              index: groups.length + 1,
              no: String(groups.length + 1),
              title: 'หมวดอุปกรณ์ทั่วไป',
              rawItem: item,
              brand: item.brand || 'Hytera',
              model: '',
              sn: '',
              subGroups: [],
              directItems: []
            };
            groups.push(currentL1);
          }
          item.sectionNo = String(currentL1.no);
          currentL2 = {
            id: 'sub-' + currentL1.index + '-' + (currentL1.subGroups.length + 1),
            parentSectionId: currentL1.id,
            sectionNo: String(currentL1.no),
            index: currentL1.subGroups.length + 1,
            no: rawNo || (currentL1.no + '.' + (currentL1.subGroups.length + 1)),
            title: rawName.replace(/#/g, '').trim(),
            rawItem: item,
            brand: item.brand || currentL1.brand || 'Hytera',
            model: item.model || '',
            sn: item.sn || '',
            villageUnits: [],
            items: []
          };
          item.parentSubId = currentL2.id;
          currentL1.subGroups.push(currentL2);
          currentVillage = null;
          currentSubCat = "";
          return;
        }

        // 3. Detect Level 3: Village / Sub-unit (หมู่บ้าน / จุดติดตั้ง)
        // e.g. "5.1.1", "5.1.2", or matches "หมู่ 13 ...", "หมู่ที่ ...", "หมู่ ..."
        let isVillage = false;
        if (!startsWithBullet && currentL2) {
          if (/^[0-9]+\.[0-9]+\.[0-9]+/.test(rawNo)) {
            isVillage = true;
          } else if (/^หมู่/i.test(rawName) || /หมู่ที่/i.test(rawName) || /หมู่\s/i.test(rawName)) {
            isVillage = true;
          }
        }

        if (isVillage) {
          const vTitle = cleanName || ('หมู่บ้าน (รหัส ' + rawNo + ')');
          item.sectionNo = currentL1 ? String(currentL1.no) : '';
          item.parentSubId = currentL2.id;
          currentVillage = {
            id: 'vil-' + currentL2.id + '-' + (currentL2.villageUnits.length + 1),
            parentSubId: currentL2.id,
            parentSectionId: currentL1 ? currentL1.id : '',
            sectionNo: currentL1 ? String(currentL1.no) : '',
            index: currentL2.villageUnits.length + 1,
            no: rawNo || (currentL2.no + '.' + (currentL2.villageUnits.length + 1)),
            title: vTitle.replace(/#/g, '').trim(),
            rawItem: item,
            items: []
          };
          currentL2.villageUnits.push(currentVillage);
          currentSubCat = "";
          return;
        }

        // Check if sub-category divider (e.g. Microwave, Outdoor Cabinet)
        if (!startsWithBullet && /^(สายอากาศ|ชุดตู้ SHF|ตู้ Outdoor)/.test(rawName)) {
          item.sectionNo = currentL1 ? String(currentL1.no) : '';
          item.parentSubId = currentL2 ? currentL2.id : '';
          currentSubCat = rawName;
          return;
        }

        // 4. Otherwise Equipment Item (รายการอุปกรณ์ย่อย)
        const itemObj = {
          ...item,
          name: cleanName,
          rawName: rawName,
          sectionNo: currentL1 ? String(currentL1.no) : '1',
          parentSubId: currentL2 ? currentL2.id : '',
          villageTitle: currentVillage ? currentVillage.title : '',
          villageNo: currentVillage ? currentVillage.no : '',
          category: currentSubCat || (currentVillage ? currentVillage.title : ''),
          brand: (item.brand && item.brand !== '-') ? item.brand : (currentL2 && currentL2.brand && currentL2.brand !== '-' ? currentL2.brand : (currentL1 && currentL1.brand ? currentL1.brand : 'Hytera')),
          model: (item.model && item.model !== '-') ? item.model : '-',
          sn: (item.sn && item.sn !== '-') ? item.sn : '-',
          qty: item.qty || '1',
          status: item.status || 'พร้อมใช้งาน (Active)',
          spec: item.spec || 'อุปกรณ์ในระบบเครือข่ายสื่อสารความถี่ SHF ตามสัญญา'
        };
        item.sectionNo = itemObj.sectionNo;
        item.parentSubId = itemObj.parentSubId;

        if (currentVillage) {
          itemObj.parentVillageId = currentVillage.id;
          itemObj.itemNo = currentVillage.no + '.' + (currentVillage.items.length + 1);
          currentVillage.items.push(itemObj);
          currentL2.items.push(itemObj);
        } else if (currentL2) {
          itemObj.parentSubId = currentL2.id;
          itemObj.itemNo = currentL2.no + '.' + (currentL2.items.length + 1);
          currentL2.items.push(itemObj);
        } else if (currentL1) {
          itemObj.parentSectionId = currentL1.id;
          itemObj.itemNo = currentL1.no + '.' + (currentL1.directItems.length + 1);
          currentL1.directItems.push(itemObj);
        } else {
          // Fallback if no L1 created yet
          currentL1 = {
            id: 'sec-1',
            index: 1,
            no: '1',
            title: 'ชุดอุปกรณ์ทั่วไป',
            subGroups: [],
            directItems: []
          };
          item.sectionNo = '1';
          itemObj.sectionNo = '1';
          groups.push(currentL1);
          itemObj.parentSectionId = currentL1.id;
          itemObj.itemNo = '1.' + (currentL1.directItems.length + 1);
          currentL1.directItems.push(itemObj);
        }
      });

      // Default expand all sections and sub-groups on first load
      if (expandedSectionIds.size === 0 && expandedSubGroupIds.size === 0) {
        groups.forEach(g => {
          expandedSectionIds.add(g.id);
          expandedDirectIds.add(g.id);
          g.subGroups.forEach(sg => expandedSubGroupIds.add(sg.id));
        });
      }

      return groups;
    }

    // Update Statistics
    function updateStatistics(groups) {
      let totalEquipment = 0;
      let totalSubGroups = 0;
      const mainSectionsCount = groups.length;

      groups.forEach(g => {
        totalEquipment += g.directItems.length;
        totalSubGroups += g.subGroups.length;
        g.subGroups.forEach(sg => {
          totalEquipment += sg.items.length;
        });
      });

      // Brand calculation
      const brands = {};
      groups.forEach(g => {
        g.directItems.forEach(it => {
          const b = (it.brand || '').trim().toUpperCase();
          if (b && b !== '-') brands[b] = (brands[b] || 0) + 1;
        });
        g.subGroups.forEach(sg => {
          sg.items.forEach(it => {
            const b = (it.brand || '').trim().toUpperCase();
            if (b && b !== '-') brands[b] = (brands[b] || 0) + 1;
          });
        });
      });
      const topBrand = Object.keys(brands).sort((a,b) => brands[b] - brands[a])[0] || 'HYTERA';

      const elStatTotal = document.getElementById('statTotal');
      if (elStatTotal) elStatTotal.textContent = totalEquipment.toLocaleString();

      const elCountHuawei = document.getElementById('statCountHuawei');
      if (elCountHuawei) elCountHuawei.textContent = `${(brands['HUAWEI'] || 0).toLocaleString()}`;

      const elCountHytera = document.getElementById('statCountHytera');
      if (elCountHytera) elCountHytera.textContent = `${(brands['HYTERA'] || 0).toLocaleString()}`;
      
      const elStatBrand = document.getElementById('statBrand');
      if (elStatBrand) elStatBrand.textContent = topBrand;

      const elStatANT = document.getElementById('statANT');
      if (elStatANT) elStatANT.textContent = totalEquipment.toLocaleString();

      const elStatANTPercent = document.getElementById('statANTPercent');
      if (elStatANTPercent) elStatANTPercent.textContent = `${totalEquipment.toLocaleString()} รายการอุปกรณ์ทั้งหมด`;

      const elSummaryBS = document.getElementById('summaryBSCount');
      if (elSummaryBS) elSummaryBS.textContent = `${mainSectionsCount} หมวดหลัก / ${totalSubGroups} หัวข้อรอง`;

      const elSummaryANT = document.getElementById('summaryANTCount');
      if (elSummaryANT) elSummaryANT.textContent = `${totalEquipment.toLocaleString()} รายการอุปกรณ์`;

      const elCurrentCount = document.getElementById('currentCount');
      if (elCurrentCount) elCurrentCount.textContent = totalEquipment.toLocaleString();

      const elTotalGroups = document.getElementById('totalGroupsCount');
      if (elTotalGroups) elTotalGroups.textContent = mainSectionsCount.toLocaleString();
    }

    // Switch View Mode: GROUPED vs FLAT
    function setViewMode(mode) {
      viewMode = mode;
      const btnGrouped = document.getElementById('btnView-GROUPED');
      const btnFlat = document.getElementById('btnView-FLAT');
      const groupedContainer = document.getElementById('groupedViewContainer');
      const flatContainer = document.getElementById('flatViewContainer');
      const accordionControls = document.getElementById('accordionControls');
      const groupCountText = document.getElementById('groupCountText');

      if (mode === 'GROUPED') {
        btnGrouped.className = "px-3.5 py-1.5 rounded-lg transition-all bg-white text-slate-900 shadow-sm font-semibold inline-flex items-center gap-1.5 whitespace-nowrap";
        btnFlat.className = "px-3.5 py-1.5 rounded-lg transition-all text-slate-600 hover:text-slate-900 inline-flex items-center gap-1.5 font-semibold whitespace-nowrap";
        groupedContainer.classList.remove('hidden');
        flatContainer.classList.add('hidden');
        accordionControls.classList.remove('hidden');
        groupCountText.classList.remove('hidden');
      } else {
        btnFlat.className = "px-3.5 py-1.5 rounded-lg transition-all bg-white text-slate-900 shadow-sm font-semibold inline-flex items-center gap-1.5 whitespace-nowrap";
        btnGrouped.className = "px-3.5 py-1.5 rounded-lg transition-all text-slate-600 hover:text-slate-900 inline-flex items-center gap-1.5 font-semibold whitespace-nowrap";
        groupedContainer.classList.add('hidden');
        flatContainer.classList.remove('hidden');
        accordionControls.classList.add('hidden');
        groupCountText.classList.add('hidden');
      }

      const groups = groupItemsIntoSets(currentData);
      renderCurrentView(groups);
    }

    // Render Current View
    function renderCurrentView(groups) {
      if (viewMode === 'GROUPED') {
        renderGroupedView(groups);
      } else {
        renderFlatView(currentData);
      }
    }

    // Helper: Split Thai title (Line 1) and English subtitle (Line 2)
    function formatSectionTitle(title) {
      if (!title) return { thai: '', eng: '' };
      const s = String(title).trim();
      
      // Section 1: ชุดอุปกรณ์ระบบศูนย์ควบคุมสถานีแม่ข่าย (Base Station Switching Center)
      if (s.includes('(Base Station Switching Center)')) {
        const thai = s.replace('(Base Station Switching Center)', '').trim();
        return { thai: thai, eng: '(Base Station Switching Center)' };
      }
      
      // Section 2: ชุดอุปกรณ์ระบบบริหารจัดการ Software-Definded WAN (SD-WAN Controller) Network Cabinet
      if (/Software-Def/i.test(s)) {
        const idx = s.search(/Software-Def/i);
        const thai = s.substring(0, idx).trim();
        const eng = s.substring(idx).trim();
        return { thai: thai, eng: eng };
      }

      return { thai: s, eng: '' };
    }

    // ==========================================
    // 3. RENDER 3-TIER GROUPED VIEW
    // ==========================================
    function renderGroupedView(groups) {
      const container = document.getElementById('groupedViewContainer');
      const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
      const sectionFilter = document.getElementById('sectionFilterSelect')?.value || 'ALL';
      container.innerHTML = '';

      if (groups.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 text-slate-400">
            <i class="fa-solid fa-layer-group text-3xl mb-2 text-slate-300"></i>
            <p class="font-medium text-slate-600">ไม่พบชุดข้อมูลในระบบ</p>
          </div>
        `;
        return;
      }

      let visibleSections = 0;
      let totalVisibleItemsInView = 0;

      groups.forEach((group) => {
        // Dropdown Section Filter: if specific section chosen, skip other sections
        if (sectionFilter !== 'ALL' && String(group.no) !== String(sectionFilter)) {
          return;
        }

        // Filter logic for Level 1, Level 2, and Equipment
        const l1Matches = group.title.toLowerCase().includes(searchVal) ||
                          String(group.no).toLowerCase().includes(searchVal);

        // Filter sub-groups
        const matchingSubGroups = [];
        group.subGroups.forEach(sg => {
          const sgMatches = sg.title.toLowerCase().includes(searchVal) ||
                            String(sg.no).toLowerCase().includes(searchVal);
          
          const hasVillages = sg.villageUnits && sg.villageUnits.length > 0;
          const matchingVillages = [];

          if (hasVillages) {
            sg.villageUnits.forEach(vil => {
              const vilMatches = vil.title.toLowerCase().includes(searchVal) ||
                                 String(vil.no).toLowerCase().includes(searchVal);
              const matchingVilItems = vil.items.filter(it => {
                return it.name.toLowerCase().includes(searchVal) ||
                       (it.brand || '').toLowerCase().includes(searchVal) ||
                       (it.model || '').toLowerCase().includes(searchVal) ||
                       String(it.sn || '').toLowerCase().includes(searchVal);
              });

              if (!searchVal || l1Matches || sgMatches || vilMatches || matchingVilItems.length > 0) {
                matchingVillages.push({
                  ...vil,
                  displayedItems: (searchVal && !l1Matches && !sgMatches && !vilMatches) ? matchingVilItems : vil.items
                });
              }
            });
          }

          const matchingItems = sg.items.filter(it => {
            return it.name.toLowerCase().includes(searchVal) ||
                   (it.brand || '').toLowerCase().includes(searchVal) ||
                   (it.model || '').toLowerCase().includes(searchVal) ||
                   String(it.sn || '').toLowerCase().includes(searchVal);
          });

          if (!searchVal || l1Matches || sgMatches || matchingItems.length > 0 || matchingVillages.length > 0) {
            matchingSubGroups.push({
              ...sg,
              displayedItems: (searchVal && !l1Matches && !sgMatches) ? matchingItems : sg.items,
              displayedVillages: matchingVillages
            });
          }
        });

        // Filter direct items
        const matchingDirectItems = group.directItems.filter(it => {
          return it.name.toLowerCase().includes(searchVal) ||
                 (it.brand || '').toLowerCase().includes(searchVal) ||
                 (it.model || '').toLowerCase().includes(searchVal) ||
                 String(it.sn || '').toLowerCase().includes(searchVal);
        });
        const displayedDirectItems = (searchVal && !l1Matches) ? matchingDirectItems : group.directItems;

        // Sub-filter check for this section:
        const activeSubFilter = sectionSubFilter[group.id] || 'ALL';
        if (activeSubFilter === '__NONE__') {
          return;
        }

        let displayedSubGroups = matchingSubGroups;
        let displayedDirect = displayedDirectItems;

        if (activeSubFilter !== 'ALL') {
          displayedSubGroups = matchingSubGroups.filter(sg => sg.id === activeSubFilter);
          displayedDirect = []; // Specific sub-topic selected -> direct items hidden
        }

        // Skip section if nothing matches
        if (searchVal && !l1Matches && displayedSubGroups.length === 0 && displayedDirect.length === 0) {
          return;
        }
        if (displayedSubGroups.length === 0 && displayedDirect.length === 0) {
          return;
        }

        visibleSections++;
        const isSecExpanded = expandedSectionIds.has(group.id) || searchVal.length > 0 || activeSubFilter !== 'ALL';
        
        let totalItemsInSec = 0;
        let totalVilInSec = 0;
        displayedSubGroups.forEach(sg => {
          totalItemsInSec += sg.displayedItems.length;
          if (sg.villageUnits) {
            totalVilInSec += (sg.displayedVillages || sg.villageUnits).length;
          }
        });
        totalItemsInSec += displayedDirect.length;
        totalVisibleItemsInView += totalItemsInSec;

        const secCard = document.createElement('div');
        secCard.className = "bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-5 transition-all hover:shadow-md";

        const secTitle = formatSectionTitle(group.title);

        secCard.innerHTML = `
          <!-- LEVEL 1: Main Section Header (หัวข้อหลัก) - ดำ น้ำเงิน เงิน -->
          <div 
            onclick="toggleSection('${group.id}')"
            class="p-4 sm:p-5 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-900 text-white flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3.5 cursor-pointer select-none group/header border-b border-slate-800"
          >
            <div class="flex items-start sm:items-center gap-3.5 flex-1 min-w-0">
              <span class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-300 border border-sky-400/40 flex items-center justify-center font-bold text-base shrink-0 mt-0.5 sm:mt-0 shadow-sm font-mono">
                ${group.no}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-start sm:items-center gap-2">
                  <div>
                    <h2 class="font-bold text-white text-base sm:text-lg group-hover/header:text-sky-300 transition-colors leading-snug">
                      ${secTitle.thai}
                    </h2>
                    ${secTitle.eng ? `
                      <div class="text-xs sm:text-sm font-normal text-sky-200/90 mt-0.5 tracking-wide">
                        ${secTitle.eng}
                      </div>
                    ` : ''}
                  </div>
                  <span class="px-2.5 py-0.5 rounded-full text-xs sm:text-[13px] font-semibold bg-white/10 text-slate-200 border border-slate-400/30 shrink-0 self-start mt-0.5">
                    หัวข้อหลัก
                  </span>
                </div>
                <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-slate-300 mt-1">
                  ${matchingSubGroups.length > 0 ? `
                    <span class="text-sky-300 font-medium">
                      <i class="fa-solid fa-layer-group text-xs mr-1 text-sky-400"></i>
                      ${activeSubFilter !== 'ALL' ? `แสดง 1 จาก ${group.subGroups.length} หัวข้อย่อย` : `${displayedSubGroups.length} หัวข้อรอง`} ${totalVilInSec > 0 ? `(${totalVilInSec} หมู่บ้าน)` : ''}
                    </span>
                  ` : ''}
                  <span class="text-slate-300 font-medium">
                    <i class="fa-solid fa-boxes-stacked text-xs mr-1 text-sky-400"></i>
                    รวม ${totalItemsInSec.toLocaleString()} รายการอุปกรณ์
                  </span>
                </div>
              </div>
            </div>

            <!-- Sub-topic Dropdown & Badges -->
            <div class="flex items-center flex-wrap sm:flex-nowrap gap-2.5 self-start lg:self-auto shrink-0" onclick="event.stopPropagation()">
              ${group.subGroups.length > 0 ? `
                <div class="relative min-w-[240px] sm:min-w-[300px] max-w-[400px]">
                  <select 
                    id="subFilter-${group.id}" 
                    onchange="handleSubGroupFilter('${group.id}', this.value)" 
                    title="เลือกแสดงเฉพาะหัวข้อย่อยนี้"
                    class="w-full appearance-none pl-8 pr-8 py-1.5 text-xs sm:text-sm bg-slate-800 hover:bg-slate-700 text-white font-medium rounded-xl border border-slate-600 hover:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-400 transition-all cursor-pointer shadow-inner"
                  >
                    <option value="ALL" ${activeSubFilter === 'ALL' ? 'selected' : ''}>📂 ทุกหัวข้อย่อย (${group.subGroups.length} หัวข้อ)</option>
                    ${group.subGroups.map(sg => {
                      const isVil = sg.villageUnits && sg.villageUnits.length > 0;
                      const countText = isVil ? `${sg.villageUnits.length} หมู่บ้าน` : `${sg.items.length} รายการ`;
                      let sgTitle = sg.title.replace(/^จังหวัด/, 'จ.').trim();
                      return `<option value="${sg.id}" ${activeSubFilter === sg.id ? 'selected' : ''}>${sg.no} ${sgTitle} (${countText})</option>`;
                    }).join('')}
                  </select>
                  <i class="fa-solid fa-filter absolute left-2.5 top-2.5 text-sky-400 text-xs pointer-events-none"></i>
                  <i class="fa-solid fa-chevron-down absolute right-2.5 top-2.5 text-slate-400 text-[10px] pointer-events-none"></i>
                </div>
              ` : ''}

              <span class="px-3 py-1 rounded-xl text-xs sm:text-sm font-semibold bg-sky-500/15 text-sky-300 border border-sky-400/30 whitespace-nowrap">
                ${totalItemsInSec.toLocaleString()} รายการ
              </span>
              <button 
                type="button"
                onclick="printSectionPdf('${group.id}')"
                title="พิมพ์เอกสาร PDF สรุปทั้งหมวดนี้ (A4)"
                class="px-2.5 py-1 rounded-xl text-xs sm:text-sm font-semibold bg-white/10 hover:bg-rose-600/40 text-rose-200 hover:text-white border border-rose-400/40 inline-flex items-center gap-1.5 transition-all shadow-xs"
              >
                <i class="fa-solid fa-file-pdf text-rose-300 text-xs"></i>
                <span class="whitespace-nowrap">พิมพ์ PDF</span>
              </button>
              <button 
                type="button"
                onclick="toggleSection('${group.id}')"
                class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 text-slate-200 hover:text-white flex items-center justify-center text-xs transition-transform duration-200"
              >
                <i class="fa-solid fa-chevron-down transition-transform duration-300 ${isSecExpanded ? 'rotate-180' : ''}"></i>
              </button>
            </div>
          </div>

          <!-- LEVEL 1 BODY (Sub-groups Container) -->
          <div id="body-${group.id}" class="${isSecExpanded ? '' : 'hidden'} p-4 sm:p-5 space-y-4 bg-slate-50/70 border-t border-slate-200">
            
            <!-- Sub-groups (LEVEL 2: หัวข้อรอง / จังหวัด) -->
            ${displayedSubGroups.map((subGroup) => {
              const isSubExpanded = expandedSubGroupIds.has(subGroup.id) || searchVal.length > 0;
              const hasVillages = subGroup.villageUnits && subGroup.villageUnits.length > 0;
              const vilList = subGroup.displayedVillages || subGroup.villageUnits || [];
              return `
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden transition-all duration-200 hover:border-sky-400">
                  <!-- Level 2 Sub-Group Header Row -->
                  <div 
                    onclick="toggleSubGroup('${subGroup.id}')"
                    class="p-3.5 sm:p-4 bg-gradient-to-r from-slate-100 via-slate-50 to-sky-50/30 hover:from-slate-200/70 hover:to-sky-100/50 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 cursor-pointer select-none transition-colors"
                  >
                    <div class="flex items-start sm:items-center gap-3">
                      <span class="w-8 h-8 rounded-lg bg-slate-800 text-white font-mono font-bold text-xs sm:text-sm flex items-center justify-center shrink-0 shadow-sm">
                        ${subGroup.no}
                      </span>
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h3 class="font-bold text-slate-900 text-base sm:text-lg">
                            ${subGroup.title}
                          </h3>
                          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-50 text-sky-800 border border-sky-200">
                            ${hasVillages ? 'จังหวัด / พื้นที่' : 'หัวข้อรอง'}
                          </span>
                        </div>
                        <div class="text-xs sm:text-sm text-slate-500 mt-0.5 flex flex-wrap items-center gap-2">
                          ${hasVillages ? `
                            <span class="text-sky-800 font-medium">
                              <i class="fa-solid fa-house-chimney text-xs mr-1 text-sky-600"></i>
                              <strong>${subGroup.villageUnits.length} หมู่บ้าน</strong>
                            </span>
                            <span class="text-slate-300">•</span>
                          ` : ''}
                          <span>
                            อุปกรณ์ในชุด: <strong class="text-sky-700 font-semibold">${subGroup.displayedItems.length} รายการ</strong>
                          </span>
                        </div>
                      </div>
                    </div>

                    <!-- Action Button: ปุ่มกดแสดงรายการอุปกรณ์ / หมู่บ้าน / พิมพ์ PDF -->
                    <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
                      ${hasVillages ? `
                        <button 
                          type="button"
                          onclick="event.stopPropagation(); printProvinceAllVillages('${subGroup.id}')"
                          title="พิมพ์รายงาน PDF ทุกหมู่บ้านในจังหวัดนี้ (A4)"
                          class="px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold inline-flex items-center gap-1.5 transition-all bg-white hover:bg-rose-50 text-rose-700 hover:text-rose-800 border border-rose-300 hover:border-rose-400 shadow-xs"
                        >
                          <i class="fa-solid fa-file-pdf text-rose-600"></i>
                          <span>พิมพ์ PDF ทุกหมู่บ้าน</span>
                        </button>
                      ` : `
                        <button 
                          type="button"
                          onclick="event.stopPropagation(); printSubGroupPdf('${subGroup.id}')"
                          title="พิมพ์รายงาน PDF ชุดนี้ (A4)"
                          class="px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold inline-flex items-center gap-1.5 transition-all bg-white hover:bg-rose-50 text-rose-700 hover:text-rose-800 border border-rose-300 hover:border-rose-400 shadow-xs"
                        >
                          <i class="fa-solid fa-file-pdf text-rose-600"></i>
                          <span>พิมพ์ PDF</span>
                        </button>
                      `}

                      <button 
                        type="button"
                        onclick="event.stopPropagation(); toggleSubGroup('${subGroup.id}')"
                        class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold inline-flex items-center gap-2 transition-all shadow-sm ${
                          isSubExpanded 
                            ? 'bg-sky-600 text-white hover:bg-sky-700 shadow-sky-600/20' 
                            : 'bg-white text-sky-700 border border-sky-300 hover:bg-sky-50'
                        }"
                      >
                        <i class="fa-solid ${isSubExpanded ? 'fa-eye-slash' : (hasVillages ? 'fa-house-chimney' : 'fa-list-check')}"></i>
                        <span>${isSubExpanded ? (hasVillages ? 'ซ่อนหมู่บ้าน' : 'ซ่อนรายการอุปกรณ์') : (hasVillages ? `แสดงรายชื่อหมู่บ้าน (${subGroup.villageUnits.length} หมู่)` : 'แสดงรายการอุปกรณ์')}</span>
                        <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200 ${isSubExpanded ? 'rotate-180' : ''}"></i>
                      </button>
                    </div>
                  </div>

                  <!-- LEVEL 2 BODY: Village Units OR Equipment Items Table -->
                  <div id="body-${subGroup.id}" class="${isSubExpanded ? '' : 'hidden'} border-t border-slate-100">
                    ${hasVillages ? `
                      <div class="p-3 sm:p-4 bg-slate-50/50 space-y-3">
                        <!-- Village Toolbar -->
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 p-2.5 bg-gradient-to-r from-sky-50/80 via-slate-50 to-sky-50/50 rounded-xl border border-sky-200/80 text-xs sm:text-sm">
                          <div class="flex items-center gap-2 text-slate-800 font-medium">
                            <i class="fa-solid fa-tree-city text-sky-600 text-sm"></i>
                            <span>รายชื่อหมู่บ้านใน ${subGroup.title}: แสดง <strong>${vilList.length}</strong> จาก ${subGroup.villageUnits.length} หมู่บ้าน</span>
                          </div>
                          <div class="flex items-center gap-2 self-end sm:self-auto">
                            <button 
                              type="button" 
                              onclick="toggleAllVillagesInSubGroup('${subGroup.id}', true)" 
                              class="px-3 py-1 rounded-lg bg-white hover:bg-sky-50 text-sky-800 border border-sky-300 text-xs sm:text-[13px] font-semibold transition-colors flex items-center gap-1.5 shadow-xs"
                            >
                              <i class="fa-solid fa-angles-down text-xs"></i>
                              <span>ขยายทุกหมู่</span>
                            </button>
                            <button 
                              type="button" 
                              onclick="toggleAllVillagesInSubGroup('${subGroup.id}', false)" 
                              class="px-3 py-1 rounded-lg bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 text-xs sm:text-[13px] font-semibold transition-colors flex items-center gap-1.5 shadow-xs"
                            >
                              <i class="fa-solid fa-angles-up text-xs"></i>
                              <span>ยุบทุกหมู่</span>
                            </button>
                          </div>
                        </div>

                        <!-- Village Cards List (กดเข้าไปที่หมู่ จะมีรายละเอียด) -->
                        <div class="space-y-2.5">
                          ${vilList.map((vil) => {
                            const isVilExpanded = expandedVillageIds.has(vil.id) || searchVal.length > 0;
                            return `
                              <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden transition-all hover:border-sky-400">
                                <!-- Village Header (คลิกเพื่อดูรายละเอียดอุปกรณ์ในหมู่) -->
                                <div 
                                  onclick="toggleVillage('${vil.id}')"
                                  class="p-3 sm:p-3.5 bg-gradient-to-r from-sky-50/20 via-white to-slate-50 hover:from-sky-50/50 hover:to-slate-100 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 cursor-pointer select-none transition-colors"
                                >
                                  <div class="flex items-start sm:items-center gap-2.5">
                                    <span class="w-7 h-7 rounded-lg bg-sky-600 text-white font-mono font-bold text-xs flex items-center justify-center shrink-0 shadow-xs">
                                      <i class="fa-solid fa-house-chimney text-xs"></i>
                                    </span>
                                    <div>
                                      <div class="flex flex-wrap items-center gap-2">
                                        <span class="font-mono text-xs sm:text-[13px] font-bold text-sky-900 bg-sky-100/80 px-2 py-0.5 rounded border border-sky-200">
                                          ${vil.no}
                                        </span>
                                        <h4 class="font-bold text-slate-900 text-sm sm:text-base">
                                          ${vil.title}
                                        </h4>
                                      </div>
                                      <div class="text-xs text-slate-500 mt-0.5 flex items-center gap-2">
                                        <span>อุปกรณ์ในหมู่: <strong class="text-sky-700 font-semibold">${vil.displayedItems.length} รายการ</strong></span>
                                      </div>
                                    </div>
                                  </div>

                                  <!-- Action Button for Village -->
                                  <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
                                    <button 
                                      type="button"
                                      onclick="event.stopPropagation(); printVillagePdf('${vil.id}')"
                                      title="พิมพ์เอกสาร PDF รายการครุภัณฑ์ประจำหมู่บ้านนี้ (A4)"
                                      class="px-2.5 py-1 rounded-lg text-xs sm:text-[13px] font-semibold inline-flex items-center gap-1.5 transition-all bg-white hover:bg-rose-50 text-rose-700 hover:text-rose-800 border border-rose-300 hover:border-rose-400 shadow-xs"
                                    >
                                      <i class="fa-solid fa-file-pdf text-rose-600 text-xs"></i>
                                      <span>พิมพ์ PDF</span>
                                    </button>

                                    <button 
                                      type="button"
                                      onclick="event.stopPropagation(); toggleVillage('${vil.id}')"
                                      class="px-3 py-1 rounded-lg text-xs sm:text-[13px] font-semibold inline-flex items-center gap-1.5 transition-all shadow-xs ${
                                        isVilExpanded 
                                          ? 'bg-sky-600 text-white hover:bg-sky-700 shadow-sky-600/20' 
                                          : 'bg-white text-sky-800 border border-sky-300 hover:bg-sky-50'
                                      }"
                                    >
                                      <i class="fa-solid ${isVilExpanded ? 'fa-eye-slash' : 'fa-list'} text-xs"></i>
                                      <span>${isVilExpanded ? 'ซ่อนรายละเอียด' : 'กดดูรายละเอียด'}</span>
                                      <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200 ${isVilExpanded ? 'rotate-180' : ''}"></i>
                                    </button>
                                  </div>
                                </div>

                                <!-- Village Items Table (แสดงเมื่อกดดูรายละเอียด) -->
                                <div id="body-${vil.id}" class="${isVilExpanded ? '' : 'hidden'} border-t border-slate-100 bg-slate-50/20">
                                  ${renderEquipmentTableHtml(vil.displayedItems, vil.no)}
                                </div>
                              </div>
                            `;
                          }).join('')}
                        </div>
                      </div>
                    ` : renderEquipmentTableHtml(subGroup.displayedItems, subGroup.no)}
                  </div>
                </div>
              `;
            }).join('')}

            <!-- Direct Items (if any, e.g. SD-WAN Cabinet) -->
            ${displayedDirect.length > 0 ? `
              <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div 
                  onclick="toggleDirectItems('${group.id}')"
                  class="p-3.5 sm:p-4 bg-slate-100 flex items-center justify-between cursor-pointer select-none"
                >
                  <div class="flex items-center gap-2.5">
                    <span class="w-7 h-7 rounded-lg bg-slate-800 text-white font-mono font-bold text-xs sm:text-sm flex items-center justify-center">
                      ${group.no}
                    </span>
                    <div>
                      <h4 class="font-bold text-slate-800 text-base">รายการอุปกรณ์ในตู้</h4>
                      <span class="text-xs sm:text-sm text-slate-500">รวม ${displayedDirect.length} รายการ</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 self-end sm:self-auto shrink-0">
                    <button 
                      type="button"
                      onclick="event.stopPropagation(); printDirectItemsPdf('${group.id}')"
                      title="พิมพ์รายงาน PDF รายการอุปกรณ์ในตู้ (A4)"
                      class="px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold inline-flex items-center gap-1.5 transition-all bg-white hover:bg-rose-50 text-rose-700 hover:text-rose-800 border border-rose-300 hover:border-rose-400 shadow-xs"
                    >
                      <i class="fa-solid fa-file-pdf text-rose-600"></i>
                      <span>พิมพ์ PDF</span>
                    </button>
                    <button 
                      type="button"
                      onclick="event.stopPropagation(); toggleDirectItems('${group.id}')"
                      class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold inline-flex items-center gap-2 transition-all shadow-sm ${
                        expandedDirectIds.has(group.id) 
                          ? 'bg-sky-600 text-white hover:bg-sky-700 shadow-sky-600/20' 
                          : 'bg-white text-sky-700 border border-sky-300 hover:bg-sky-50'
                      }"
                    >
                      <i class="fa-solid ${expandedDirectIds.has(group.id) ? 'fa-eye-slash' : 'fa-list-check'}"></i>
                      <span>${expandedDirectIds.has(group.id) ? 'ซ่อนรายการอุปกรณ์' : 'แสดงรายการอุปกรณ์'}</span>
                      <i class="fa-solid fa-chevron-down text-xs transition-transform duration-200 ${expandedDirectIds.has(group.id) ? 'rotate-180' : ''}"></i>
                    </button>
                  </div>
                </div>
                <div id="body-direct-${group.id}" class="${expandedDirectIds.has(group.id) ? '' : 'hidden'} border-t border-slate-100">
                  ${renderEquipmentTableHtml(displayedDirect, group.no)}
                </div>
              </div>
            ` : ''}

          </div>
        `;

        container.appendChild(secCard);
      });

      // Update result count counters
      const elCurrentCount = document.getElementById('currentCount');
      if (elCurrentCount) {
        elCurrentCount.textContent = totalVisibleItemsInView.toLocaleString();
      }

      const elGroupCountText = document.getElementById('groupCountText');
      if (elGroupCountText) {
        if (searchVal) {
          elGroupCountText.innerHTML = `พบ <strong>${visibleSections}</strong> หมวด • <strong>${totalVisibleItemsInView.toLocaleString()}</strong> รายการที่ตรงกับคำค้นหา`;
        } else if (visibleSections === 1) {
          elGroupCountText.innerHTML = `กำลังแสดง <strong>1</strong> หมวด • <strong>${totalVisibleItemsInView.toLocaleString()}</strong> รายการ`;
        } else {
          elGroupCountText.innerHTML = `กำลังแสดง <strong>${visibleSections}</strong> หมวดหลัก (1 ถึง ${groups.length})`;
        }
      }

      if (visibleSections === 0) {
        container.innerHTML = `
          <div class="text-center py-10 text-slate-400">
            <i class="fa-solid fa-magnifying-glass text-2xl mb-1 text-slate-300"></i>
            <p class="font-medium text-slate-600 text-sm">ไม่พบรายการครุภัณฑ์หรือชุดอุปกรณ์ที่ค้นหา</p>
            <p class="text-xs text-slate-400 mt-0.5">ลองเลือกหัวข้ออื่น หรือเปลี่ยนคำค้นหา</p>
          </div>
        `;
      }
    }

    // Helper: Render Level 3 Equipment Items Table
    function renderEquipmentTableHtml(items, parentNo) {
      if (!items || items.length === 0) {
        return `
          <div class="p-4 text-center text-xs sm:text-sm text-slate-400 italic">
            (ไม่มีรายการอุปกรณ์ย่อยภายใต้ชุดนี้)
          </div>
        `;
      }

      return `
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="bg-slate-50/90 text-slate-700 font-bold border-b border-slate-200/90 text-xs sm:text-sm tracking-wide">
                <th class="py-2.5 px-4 text-center w-16">ลำดับ</th>
                <th class="py-2.5 px-4">รายการอุปกรณ์ย่อย (Component Description)</th>
                <th class="py-2.5 px-4">ยี่ห้อ (Brand)</th>
                <th class="py-2.5 px-4 whitespace-nowrap">รุ่น (Model)</th>
                <th class="py-2.5 px-4 whitespace-nowrap">หมายเลขเครื่อง (S/N)</th>
                <th class="py-2.5 px-4 text-center">จำนวน</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
              ${items.map((it, idx) => {
                const hasSn = it.sn && it.sn !== '-' && it.sn.trim() !== '';
                const displayNo = it.itemNo || `${parentNo}.${idx + 1}`;
                return `
                  <tr class="hover:bg-sky-50/40 transition-colors group">
                    <td class="py-2.5 px-4 text-center font-mono text-xs sm:text-sm text-slate-400">
                      ${displayNo}
                    </td>
                    <td class="py-2.5 px-4">
                      <div class="flex items-center gap-2">
                        <span class="text-sky-500 font-mono text-sm leading-none select-none">↳</span>
                        <span class="font-semibold text-slate-800 group-hover:text-sky-700 text-sm sm:text-[15px] transition-colors">
                          ${it.name}
                        </span>
                      </div>
                      ${it.category ? `<span class="text-xs text-slate-400 ml-5 block">${it.category}</span>` : ''}
                    </td>
                    <td class="py-2.5 px-4 whitespace-nowrap">
                      ${it.brand && it.brand !== '-' ? `
                        <span class="inline-flex items-center gap-1 text-xs sm:text-sm px-2.5 py-0.5 rounded bg-slate-100 text-slate-800 font-semibold border border-slate-200 whitespace-nowrap">
                          ${it.brand}
                        </span>
                      ` : '<span class="text-slate-400 text-xs sm:text-sm">-</span>'}
                    </td>
                    <td class="py-2.5 px-4 whitespace-nowrap">
                      ${it.model && it.model !== '-' ? `
                        <span class="bg-slate-100 text-slate-800 font-semibold px-2.5 py-0.5 rounded border border-slate-200 text-xs sm:text-sm inline-block whitespace-nowrap">
                          ${it.model}
                        </span>
                      ` : '<span class="text-slate-400 text-xs sm:text-sm">-</span>'}
                    </td>
                    <td class="py-2.5 px-4 whitespace-nowrap">
                      ${hasSn ? `
                        <button 
                          onclick="copyToClipboard('${it.sn}')" 
                          title="คลิกเพื่อคัดลอก S/N" 
                          class="inline-flex items-center gap-1.5 font-semibold text-slate-800 bg-slate-100 hover:bg-sky-50 hover:text-sky-700 hover:border-sky-300 px-2.5 py-0.5 rounded border border-slate-200 transition-all text-xs sm:text-sm whitespace-nowrap group/btn"
                        >
                          <span class="whitespace-nowrap">${it.sn}</span>
                          <i class="fa-regular fa-copy text-slate-400 group-hover/btn:text-sky-700 text-xs"></i>
                        </button>
                      ` : '<span class="text-slate-400 text-xs sm:text-sm">-</span>'}
                    </td>
                    <td class="py-2.5 px-4 text-center font-bold text-slate-700 text-xs sm:text-sm">
                      ${it.qty || '1'}
                    </td>
                  </tr>
                `;
              }).join('')}
            </tbody>
          </table>
        </div>
      `;
    }

    // Toggle Level 1 Section
    function toggleSection(secId) {
      if (expandedSectionIds.has(secId)) {
        expandedSectionIds.delete(secId);
      } else {
        expandedSectionIds.add(secId);
      }
      const groups = groupItemsIntoSets(currentData);
      renderGroupedView(groups);
    }

    // Toggle Level 2 Sub-Group (ปุ่มกดแสดงรายการอุปกรณ์ / หมู่บ้าน)
    function toggleSubGroup(subId) {
      if (expandedSubGroupIds.has(subId)) {
        expandedSubGroupIds.delete(subId);
      } else {
        expandedSubGroupIds.add(subId);
      }
      const groups = groupItemsIntoSets(currentData);
      renderGroupedView(groups);
    }

    // Toggle Level 3 Village (ปุ่มกดแสดงรายละเอียดอุปกรณ์ในหมู่บ้าน)
    function toggleVillage(vilId) {
      if (expandedVillageIds.has(vilId)) {
        expandedVillageIds.delete(vilId);
      } else {
        expandedVillageIds.add(vilId);
      }
      const groups = groupItemsIntoSets(currentData);
      renderGroupedView(groups);
    }

    // Toggle All Villages in a Sub-Group
    function toggleAllVillagesInSubGroup(subId, expand) {
      const groups = groupItemsIntoSets(currentData);
      for (const g of groups) {
        const targetSub = g.subGroups.find(sg => sg.id === subId);
        if (targetSub && targetSub.villageUnits) {
          targetSub.villageUnits.forEach(vil => {
            if (expand) {
              expandedVillageIds.add(vil.id);
            } else {
              expandedVillageIds.delete(vil.id);
            }
          });
          break;
        }
      }
      renderGroupedView(groups);
    }

    // Toggle Direct Items under Level 1
    function toggleDirectItems(secId) {
      if (expandedDirectIds.has(secId)) {
        expandedDirectIds.delete(secId);
      } else {
        expandedDirectIds.add(secId);
      }
      const groups = groupItemsIntoSets(currentData);
      renderGroupedView(groups);
    }

    // Expand or Collapse All Groups
    function expandAllGroups(expand) {
      const groups = groupItemsIntoSets(currentData);
      if (expand) {
        groups.forEach(g => {
          expandedSectionIds.add(g.id);
          expandedDirectIds.add(g.id);
          g.subGroups.forEach(sg => {
            expandedSubGroupIds.add(sg.id);
            if (sg.villageUnits) {
              sg.villageUnits.forEach(vil => expandedVillageIds.add(vil.id));
            }
          });
        });
      } else {
        expandedSectionIds.clear();
        expandedSubGroupIds.clear();
        expandedDirectIds.clear();
        expandedVillageIds.clear();
      }
      renderGroupedView(groups);
    }

    // ==========================================
    // 4. RENDER FLAT TABLE VIEW
    // ==========================================
    function renderFlatView(items) {
      const tbody = document.getElementById('flatTableBody');
      const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
      const subToolbarFilter = document.getElementById('subTopicToolbarSelect')?.value || 'ALL';
      tbody.innerHTML = '';

      const groups = groupItemsIntoSets(currentData);

      const filtered = items.filter(item => {
        if (subToolbarFilter !== 'ALL') {
          if (subToolbarFilter.startsWith('SEC_')) {
            const secId = subToolbarFilter.replace('SEC_', '');
            const targetGroup = groups.find(g => g.id === secId);
            if (targetGroup && String(item.sectionNo) !== String(targetGroup.no)) {
              return false;
            }
          } else if (item.parentSubId !== subToolbarFilter) {
            return false;
          }
        }
        const name = (item.name || '').toLowerCase();
        const model = (item.model || '').toLowerCase();
        const sn = String(item.sn || '').toLowerCase();
        const brand = (item.brand || '').toLowerCase();
        const no = String(item.no || '').toLowerCase();
        return name.includes(searchVal) || model.includes(searchVal) || sn.includes(searchVal) || brand.includes(searchVal) || no.includes(searchVal);
      });

      const elCurrentCount = document.getElementById('currentCount');
      if (elCurrentCount) {
        elCurrentCount.textContent = filtered.length.toLocaleString();
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-10 text-slate-400">ไม่พบรายการครุภัณฑ์ที่ค้นหา</td></tr>`;
        return;
      }

      filtered.forEach((item, index) => {
        const rawName = String(item.name || '').trim();
        const rawNo = String(item.no || '').trim();
        const isVil = /^[0-9]+\.[0-9]+\.[0-9]+/.test(rawNo) || rawName.startsWith('หมู่');
        const isSub = item.isSubItem === true || rawName.startsWith('-') || rawName.startsWith('•');
        const cleanName = rawName.replace(/^[-*•↳\s]+/, '').replace(/#/g, '').trim() || (isVil ? `หมู่บ้าน (รหัส ${rawNo})` : '');
        const hasSn = item.sn && item.sn !== '-' && item.sn.trim() !== '';

        const row = document.createElement('tr');
        row.className = isSub ? "bg-slate-50/50 hover:bg-sky-50/40 transition-colors" : (isVil ? "bg-sky-50/30 hover:bg-sky-50/60 transition-colors" : "bg-white hover:bg-slate-50 transition-colors font-medium");
        
        row.innerHTML = `
          <td class="py-2.5 px-4 text-center font-mono text-xs sm:text-sm text-slate-500">${item.no || (index + 1)}</td>
          <td class="py-2.5 px-4">
            <span class="inline-flex items-center text-xs sm:text-[13px] px-2.5 py-0.5 rounded-full border font-semibold ${
              isSub ? 'bg-slate-100 text-slate-700 border-slate-300' : 
              (isVil ? 'bg-sky-50 text-sky-800 border-sky-200' : 'bg-slate-900 text-white border-slate-800')
            }">
              ${isSub ? 'อุปกรณ์ย่อย' : (isVil ? 'หมู่บ้าน / จุดติดตั้ง' : 'หัวข้อหลัก')}
            </span>
          </td>
          <td class="py-2.5 px-4">
            <div class="${isSub ? 'pl-3 flex items-center gap-1.5' : (isVil ? 'font-semibold text-sky-950 flex items-center gap-1.5' : 'font-bold text-slate-900')} text-sm sm:text-[15px]">
              ${isSub ? '<span class="text-sky-500 font-mono text-sm">↳</span>' : (isVil ? '<i class="fa-solid fa-house-chimney text-sky-600 text-xs mr-1"></i>' : '')}
              <span>${cleanName}</span>
            </div>
          </td>
          <td class="py-2.5 px-4 whitespace-nowrap">
            <span class="inline-flex items-center gap-1 text-xs sm:text-sm px-2.5 py-0.5 rounded bg-slate-100 text-slate-800 font-semibold border border-slate-200 whitespace-nowrap">
              ${item.brand || 'Hytera'}
            </span>
          </td>
          <td class="py-2.5 px-4 whitespace-nowrap">
            <span class="bg-slate-100 text-slate-800 px-2.5 py-0.5 rounded border border-slate-200 text-xs sm:text-sm font-semibold inline-block whitespace-nowrap">
              ${item.model || '-'}
            </span>
          </td>
          <td class="py-2.5 px-4 whitespace-nowrap">
            ${hasSn ? `
              <button onclick="copyToClipboard('${item.sn}')" class="text-xs sm:text-sm font-semibold text-slate-800 bg-slate-100 hover:bg-sky-50 hover:text-sky-700 hover:border-sky-300 px-2.5 py-0.5 rounded border border-slate-200 transition-colors whitespace-nowrap">
                ${item.sn}
              </button>
            ` : '<span class="text-slate-400 text-xs sm:text-sm whitespace-nowrap">-</span>'}
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    // Search handler
    function handleSearch() {
      const searchVal = document.getElementById('searchInput').value.trim();
      document.getElementById('clearSearchBtn').classList.toggle('hidden', searchVal.length === 0);
      const groups = groupItemsIntoSets(currentData);
      renderCurrentView(groups);
    }

    function clearSearch() {
      document.getElementById('searchInput').value = '';
      handleSearch();
      document.getElementById('searchInput').focus();
    }

    // Modal Details
    function openDetailModal(identifier) {
      const idStr = String(identifier || '').trim();
      const item = currentData.find(d => String(d.sn) === idStr || String(d.name).includes(idStr));
      if (!item) return;

      const cleanTitle = (item.name || '').replace(/^[-*•↳\s]+/, '') || 'รายละเอียดอุปกรณ์';
      document.getElementById('modalTitle').textContent = cleanTitle;
      document.getElementById('modalCategory').textContent = `${item.no ? 'ลำดับ: ' + item.no + ' • ' : ''}รายการอุปกรณ์ในระบบ`;
      
      const modalIcon = document.getElementById('modalIcon');
      modalIcon.innerHTML = '<i class="fa-solid fa-server text-lg"></i>';

      const modalBody = document.getElementById('modalBody');
      modalBody.innerHTML = `
        <div class="grid grid-cols-2 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200/80">
          <div>
            <span class="text-xs sm:text-sm text-slate-500 block">ยี่ห้อ (Brand)</span>
            <span class="font-semibold text-slate-800 text-sm sm:text-base">${item.brand || 'Hytera'}</span>
          </div>
          <div>
            <span class="text-xs sm:text-sm text-slate-500 block">รุ่น (Model)</span>
            <span class="font-mono font-semibold text-slate-800 text-xs sm:text-sm">${item.model || '-'}</span>
          </div>
          <div>
            <span class="text-xs sm:text-sm text-slate-500 block">หมายเลขประจำเครื่อง (S/N)</span>
            <span class="font-mono font-bold text-sky-700 text-sm sm:text-base">${item.sn || '-'}</span>
          </div>
          <div>
            <span class="text-xs sm:text-sm text-slate-500 block">สถานะอุปกรณ์</span>
            <span class="inline-flex items-center gap-1 text-xs sm:text-sm text-sky-700 font-semibold">
              <i class="fa-solid fa-circle-check"></i> ${item.status || 'พร้อมใช้งาน'}
            </span>
          </div>
        </div>

        <div class="space-y-1">
          <span class="text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider">คุณลักษณะเฉพาะ (Specification)</span>
          <p class="text-xs sm:text-sm text-slate-700 bg-white p-3.5 rounded-lg border border-slate-200 leading-relaxed">
            ${item.spec || 'อุปกรณ์ในระบบเครือข่ายสื่อสารความถี่ SHF 800MHz ตามข้อกำหนดสัญญา'}
          </p>
        </div>

        <div class="space-y-1">
          <span class="text-xs sm:text-sm font-semibold text-slate-600 uppercase tracking-wider">ข้อมูลโครงการและผู้รับสัญญา</span>
          <div class="text-xs sm:text-sm text-slate-600 bg-slate-100/70 p-3.5 rounded-lg border border-slate-200 space-y-1.5">
            <p><strong>ผู้รับสัญญา:</strong> บริษัท ฟอร์ท คอร์ปอเรชั่น จำกัด (มหาชน)</p>
            <p><strong>สัญญาเลขที่:</strong> 8680228 (ลงวันที่ 23 กรกฎาคม 2568)</p>
            <p><strong>โครงการ:</strong> เพิ่มประสิทธิภาพระบบโครงข่ายสื่อสารความเร็วสูง</p>
          </div>
        </div>
      `;

      document.getElementById('detailModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('detailModal').classList.add('hidden');
    }

    // ==========================================
    // 5. EXCEL IMPORT & PARSING (SheetJS)
    // ==========================================
    function openExcelModal() {
      document.getElementById('excelModal').classList.remove('hidden');
    }

    function closeExcelModal() {
      document.getElementById('excelModal').classList.add('hidden');
    }

    const dropzone = document.getElementById('dropzone');
    if (dropzone) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dropzone-active');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dropzone-active');
        }, false);
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0) processExcelFile(files[0]);
      });
    }

    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (file) processExcelFile(file);
    }

    function processExcelFile(file) {
      const statusDiv = document.getElementById('fileUploadStatus');
      statusDiv.className = "p-3 rounded-xl text-xs flex items-center justify-between border bg-blue-50 text-blue-800 border-blue-200";
      statusDiv.innerHTML = `<span><i class="fa-solid fa-spinner fa-spin mr-1.5"></i> กำลังอ่านไฟล์: ${file.name}...</span>`;
      statusDiv.classList.remove('hidden');

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheetName = workbook.SheetNames[0];
          const worksheet = workbook.Sheets[firstSheetName];
          const rawRows = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
          
          if (!rawRows || rawRows.length === 0) {
            throw new Error("ไม่พบข้อมูลในไฟล์ Excel");
          }

          const parsedItems = parseExcelRows(rawRows);
          if (parsedItems.length === 0) {
            throw new Error("ไม่พบแถวข้อมูลครุภัณฑ์ หรือหัวตารางไม่ตรงตามรูปแบบ");
          }

          currentData = parsedItems;
          try {
            localStorage.setItem('shf_inventory_data', JSON.stringify(currentData));
            localStorage.setItem('shf_inventory_source', file.name);
          } catch(storageErr) {
            console.warn('LocalStorage save failed:', storageErr);
          }
          
          updateSourceBadge(file.name);
          expandedSectionIds.clear();
          expandedSubGroupIds.clear();
          expandedVillageIds.clear();
          expandedDirectIds.clear();
          refreshDashboard();

          statusDiv.className = "p-3 rounded-xl text-xs flex items-center justify-between border bg-sky-50 text-sky-900 border-sky-200";
          statusDiv.innerHTML = `
            <span><i class="fa-solid fa-circle-check mr-1.5 text-sky-600"></i> นำเข้าข้อมูลสำเร็จ: <strong>${parsedItems.length.toLocaleString()} รายการ</strong> (จัดหมวด 3 ระดับเรียบร้อย)</span>
            <button onclick="closeExcelModal()" class="px-2.5 py-1 bg-sky-600 hover:bg-sky-500 text-white rounded-lg text-[11px] font-semibold transition-colors">ตกลง</button>
          `;

          showToast(`อัปเดตข้อมูลสำเร็จ ${parsedItems.length.toLocaleString()} รายการ จาก Excel`);
          setTimeout(() => closeExcelModal(), 1500);

        } catch(err) {
          statusDiv.className = "p-3 rounded-xl text-xs flex items-center justify-between border bg-rose-50 text-rose-800 border-rose-200";
          statusDiv.innerHTML = `<span><i class="fa-solid fa-triangle-exclamation mr-1.5 text-rose-600"></i> ${err.message || 'เกิดข้อผิดพลาดในการอ่านไฟล์'}</span>`;
        }
      };

      reader.readAsArrayBuffer(file);
    }

    // ==========================================
    // GOOGLE SHEETS LIVE AUTO-SYNC (JSONP)
    // ==========================================
    const GOOGLE_SHEET_ID = '1NZrR_0i54ynjmTmXuEgCxTsC53jDNEdSl_dYe_sc_pU';
    const GOOGLE_SHEET_URL = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/edit?usp=sharing`;
    const AUTO_SYNC_INTERVAL_SEC = 30;
    let autoSyncCountdown = AUTO_SYNC_INTERVAL_SEC;
    let isAutoSyncing = false;
    let isInitialLoad = true;
    let autoSyncCountdownTimer = null;

    function syncFromGoogleSheets(isUserTriggered = false) {
      if (isAutoSyncing) return;
      isAutoSyncing = true;
      window._lastSyncWasManual = isUserTriggered;

      const syncIcon = document.getElementById('syncIcon');
      const syncCountdown = document.getElementById('syncCountdown');
      if (syncIcon) syncIcon.classList.add('fa-spin');
      if (syncCountdown && isUserTriggered) syncCountdown.textContent = '(ซิงค์...)';

      const oldScript = document.getElementById('gvizSyncScript');
      if (oldScript) oldScript.remove();

      const script = document.createElement('script');
      script.id = 'gvizSyncScript';
      script.src = `https://docs.google.com/spreadsheets/d/${GOOGLE_SHEET_ID}/gviz/tq?tqx=responseHandler:handleGoogleSheetSync&_t=${Date.now()}`;
      script.onerror = function() {
        isAutoSyncing = false;
        if (syncIcon) syncIcon.classList.remove('fa-spin');
        if (syncCountdown) syncCountdown.textContent = `(${autoSyncCountdown}s)`;
        if (isUserTriggered) {
          showToast('ไม่สามารถเชื่อมต่อ Google Sheets ได้ในขณะนี้ (ใช้ข้อมูลล่าสุดในระบบ)');
        }
      };
      document.head.appendChild(script);
    }

    window.handleGoogleSheetSync = function(response) {
      isAutoSyncing = false;
      const syncIcon = document.getElementById('syncIcon');
      const syncCountdown = document.getElementById('syncCountdown');
      if (syncIcon) syncIcon.classList.remove('fa-spin');

      try {
        if (!response || !response.table || !response.table.rows) {
          throw new Error('ไม่พบตารางข้อมูลจาก Google Sheets');
        }

        const header = response.table.cols.map(c => c ? (c.label || c.id || '') : '');
        const rawRows = [header];
        response.table.rows.forEach(r => {
          if (!r || !r.c) return;
          rawRows.push(r.c.map(cell => {
            if (!cell) return '';
            if (cell.v !== null && cell.v !== undefined) return String(cell.v).trim();
            if (cell.f !== null && cell.f !== undefined) return String(cell.f).trim();
            return '';
          }));
        });

        const parsedItems = parseExcelRows(rawRows);
        if (parsedItems.length === 0) {
          throw new Error('ไม่พบแถวข้อมูลครุภัณฑ์ที่ถูกต้อง');
        }

        const prevItemsCount = currentData ? currentData.length : 0;
        currentData = parsedItems;
        try {
          localStorage.setItem('shf_inventory_data', JSON.stringify(currentData));
          localStorage.setItem('shf_inventory_source', 'ซิงค์ Google Sheets อัตโนมัติ');
        } catch(storageErr) {
          console.warn('LocalStorage save failed:', storageErr);
        }

        const timeStr = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
        updateSourceBadge(`ซิงค์ Google Sheets อัตโนมัติ (${timeStr})`);
        
        // Reset countdown timer
        autoSyncCountdown = AUTO_SYNC_INTERVAL_SEC;
        if (syncCountdown) syncCountdown.textContent = `(${autoSyncCountdown}s)`;

        // Only clear/reset accordions on the initial fresh load; preserve user view on background sync
        if (isInitialLoad) {
          expandedSectionIds.clear();
          expandedSubGroupIds.clear();
          expandedVillageIds.clear();
          expandedDirectIds.clear();
          isInitialLoad = false;
        }

        refreshDashboard();

        if (window._lastSyncWasManual) {
          showToast(`ซิงค์ข้อมูล Google Sheets สำเร็จ ${parsedItems.length.toLocaleString()} รายการ (${timeStr})`);
          window._lastSyncWasManual = false;
        } else if (prevItemsCount > 0 && prevItemsCount !== parsedItems.length) {
          showToast(`อัปเดตข้อมูลจาก Google Sheets อัตโนมัติแล้ว (${parsedItems.length.toLocaleString()} รายการ)`);
        }
      } catch(err) {
        console.error('Google Sheet Sync Error:', err);
        if (window._lastSyncWasManual) {
          showToast('เกิดข้อผิดพลาดในการแปลงข้อมูล: ' + err.message);
          window._lastSyncWasManual = false;
        }
      }
    };

    function startAutoSyncLoop() {
      if (autoSyncCountdownTimer) clearInterval(autoSyncCountdownTimer);
      autoSyncCountdown = AUTO_SYNC_INTERVAL_SEC;
      autoSyncCountdownTimer = setInterval(() => {
        if (!isAutoSyncing) {
          autoSyncCountdown--;
          const syncCountdown = document.getElementById('syncCountdown');
          if (syncCountdown) {
            syncCountdown.textContent = autoSyncCountdown > 0 ? `(${autoSyncCountdown}s)` : `(ซิงค์...)`;
          }
          if (autoSyncCountdown <= 0) {
            autoSyncCountdown = AUTO_SYNC_INTERVAL_SEC;
            syncFromGoogleSheets(false);
          }
        }
      }, 1000);
    }

    // Intelligent Excel Parser for 3-Tier Hierarchy
    function parseExcelRows(rows) {
      let headerRowIndex = -1;
      let colMap = { no: -1, cat: -1, name: -1, brand: -1, model: -1, sn: -1, qty: -1, status: -1 };

      // Search for header row
      for (let i = 0; i < Math.min(rows.length, 15); i++) {
        const row = rows[i];
        if (!row || row.length === 0) continue;

        row.forEach((cell, colIdx) => {
          const text = String(cell || '').trim().toLowerCase();
          if (text.includes('ลำดับ') || text === 'no' || text === 'no.' || text === '#') colMap.no = colIdx;
          if (text.includes('ประเภท') || text.includes('ชนิด') || text === 'category' || text === 'type') colMap.cat = colIdx;
          if (text.includes('รายการ') || text.includes('สถานี') || text.includes('ชื่อ') || text.includes('description') || text.includes('station') || text.includes('อุปกรณ์')) colMap.name = colIdx;
          if (text.includes('ยี่ห้อ') || text.includes('ตราสินค้า') || text.includes('brand') || text.includes('make')) colMap.brand = colIdx;
          if (text.includes('รุ่น') || text.includes('แบบ') || text.includes('model')) colMap.model = colIdx;
          if (text.includes('หมายเลข') || text.includes('serial') || text.includes('s/n') || text.includes('sn') || text.includes('ซีเรียล') || text.includes('เลขประจำเครื่อง')) colMap.sn = colIdx;
          if (text.includes('จำนวน') || text === 'qty' || text === 'quantity') colMap.qty = colIdx;
          if (text.includes('สถานะ') || text.includes('status')) colMap.status = colIdx;
        });

        if ((colMap.sn !== -1 || colMap.name !== -1) && (colMap.model !== -1 || colMap.brand !== -1 || colMap.no !== -1)) {
          headerRowIndex = i;
          break;
        }
      }

      if (headerRowIndex === -1) {
        headerRowIndex = 0;
        colMap = { no: 0, cat: 1, name: 1, brand: 2, model: 3, sn: 4, qty: 5, status: 6 };
      }

      const items = [];

      for (let i = headerRowIndex + 1; i < rows.length; i++) {
        const row = rows[i];
        if (!row || row.length === 0) continue;

        let rawNo = colMap.no !== -1 && row[colMap.no] !== undefined && row[colMap.no] !== null ? String(row[colMap.no]).trim().replace(/#/g, '') : '';
        const nameVal = colMap.name !== -1 && row[colMap.name] ? String(row[colMap.name]).trim().replace(/#/g, '') : '';
        const modelVal = colMap.model !== -1 && row[colMap.model] ? String(row[colMap.model]).trim().replace(/#/g, '') : '';
        let snVal = colMap.sn !== -1 && row[colMap.sn] ? String(row[colMap.sn]).trim().replace(/#/g, '') : '';
        const brandVal = colMap.brand !== -1 && row[colMap.brand] ? String(row[colMap.brand]).trim().replace(/#/g, '') : '';
        const qtyVal = colMap.qty !== -1 && row[colMap.qty] ? String(row[colMap.qty]).trim().replace(/#/g, '') : '1';

        // Format decimal numbering if floating point (e.g. 1.1000000000000001 -> 1.1)
        if (/^\d+\.\d+$/.test(rawNo)) {
          const num = parseFloat(rawNo);
          rawNo = String(Math.round(num * 100) / 100);
        }

        // Skip completely empty lines
        if (!rawNo && !nameVal && !modelVal && !snVal) continue;

        items.push({
          no: rawNo,
          name: nameVal,
          brand: brandVal === '-' ? '' : brandVal,
          model: modelVal === '-' ? '' : modelVal,
          sn: snVal === '-' ? '' : snVal,
          qty: qtyVal,
          status: 'พร้อมใช้งาน (Active)'
        });
      }

      return items;
    }

    // ==========================================
    // 6. EXPORT TO EXCEL (สรุปรายงานตาม 5 หัวข้อที่ระบุ)
    // ==========================================
    // 1.รายการชุดอุปกรณ์หลัก 2.ชุดอุปกรณ์ย่อย 3.Model 4.Serial 5.จำนวน (เรียงลำดับตามข้อมูล)
    function exportToCSV() {
      exportExcelSummaryReport();
    }

    function exportExcelSummaryReport() {
      const groups = groupItemsIntoSets(currentData);
      
      // Sheet 1: สรุปรายงานตามหัวข้อ (Summary Sheet strictly matching requested topics)
      const summaryRows = [];
      let seqNo = 1;

      groups.forEach(g => {
        const mainTitle = g.title || 'ชุดอุปกรณ์หลัก';

        // 1. Traverse Sub-Groups
        g.subGroups.forEach(sg => {
          const sgTitle = sg.title || '';
          sg.items.forEach(it => {
            const subName = it.name || '';
            const vilText = it.villageTitle ? ` > ${it.villageTitle}` : '';
            const subItemDisplay = sgTitle ? `${sgTitle}${vilText} : ${subName}` : subName;

            summaryRows.push({
              "ลำดับ": seqNo++,
              "รายการชุดอุปกรณ์หลัก": mainTitle,
              "ชุดอุปกรณ์ย่อย": subItemDisplay,
              "Model": (it.model && it.model !== '-') ? it.model : '-',
              "Serial": (it.sn && it.sn !== '-') ? it.sn : '-',
              "จำนวน": it.qty ? String(it.qty).trim() : '1'
            });
          });
        });

        // 2. Traverse Direct Items
        g.directItems.forEach(it => {
          const subName = it.name || '';
          summaryRows.push({
            "ลำดับ": seqNo++,
            "รายการชุดอุปกรณ์หลัก": mainTitle,
            "ชุดอุปกรณ์ย่อย": subName,
            "Model": (it.model && it.model !== '-') ? it.model : '-',
            "Serial": (it.sn && it.sn !== '-') ? it.sn : '-',
            "จำนวน": it.qty ? String(it.qty).trim() : '1'
          });
        });
      });

      // Sheet 2: รายละเอียดแบบแยกคอลัมน์สถานี/ชุดควบคุม/หมู่บ้าน (Detailed Sheet)
      const detailedRows = [];
      let detailSeqNo = 1;

      groups.forEach(g => {
        const mainTitle = g.title || 'ชุดอุปกรณ์หลัก';

        g.subGroups.forEach(sg => {
          const sgTitle = sg.title || '';
          sg.items.forEach(it => {
            detailedRows.push({
              "ลำดับ": detailSeqNo++,
              "รายการชุดอุปกรณ์หลัก": mainTitle,
              "สถานี / ชุดควบคุม / จังหวัด": sgTitle,
              "หมู่บ้าน / จุดติดตั้ง": it.villageTitle || '-',
              "ชุดอุปกรณ์ย่อย": it.name || '',
              "ยี่ห้อ (Brand)": it.brand || '-',
              "Model": (it.model && it.model !== '-') ? it.model : '-',
              "Serial": (it.sn && it.sn !== '-') ? it.sn : '-',
              "จำนวน": it.qty ? String(it.qty).trim() : '1'
            });
          });
        });

        g.directItems.forEach(it => {
          detailedRows.push({
            "ลำดับ": detailSeqNo++,
            "รายการชุดอุปกรณ์หลัก": mainTitle,
            "สถานี / ชุดควบคุม / จังหวัด": "-",
            "หมู่บ้าน / จุดติดตั้ง": "-",
            "ชุดอุปกรณ์ย่อย": it.name || '',
            "ยี่ห้อ (Brand)": it.brand || '-',
            "Model": (it.model && it.model !== '-') ? it.model : '-',
            "Serial": (it.sn && it.sn !== '-') ? it.sn : '-',
            "จำนวน": it.qty ? String(it.qty).trim() : '1'
          });
        });
      });

      // Sheet 3: สรุปภาพรวมตามชุดอุปกรณ์หลัก (Overview Sheet)
      const overviewRows = groups.map((g, idx) => {
        let itemCount = 0;
        let totalQty = 0;
        g.subGroups.forEach(sg => {
          itemCount += sg.items.length;
          sg.items.forEach(it => {
            totalQty += parseInt(it.qty || '1', 10) || 1;
          });
        });
        itemCount += g.directItems.length;
        g.directItems.forEach(it => {
          totalQty += parseInt(it.qty || '1', 10) || 1;
        });

        return {
          "ลำดับ": idx + 1,
          "รายการชุดอุปกรณ์หลัก": g.title,
          "จำนวนสถานี/ชุดย่อย": g.subGroups.length > 0 ? `${g.subGroups.length} ชุด/สถานี` : 'รวมในตู้',
          "จำนวนรายการอุปกรณ์": `${itemCount} รายการ`,
          "จำนวนเครื่องรวม (ชิ้น)": totalQty
        };
      });

      const wb = XLSX.utils.book_new();

      // Append Sheet 1: สรุปตามหัวข้อ (5 หัวข้อที่ระบุ)
      const wsSummary = XLSX.utils.json_to_sheet(summaryRows);
      wsSummary['!cols'] = [
        { wch: 8 },  // ลำดับ
        { wch: 48 }, // รายการชุดอุปกรณ์หลัก
        { wch: 65 }, // ชุดอุปกรณ์ย่อย
        { wch: 28 }, // Model
        { wch: 24 }, // Serial
        { wch: 10 }  // จำนวน
      ];
      XLSX.utils.book_append_sheet(wb, wsSummary, "สรุปบัญชีครุภัณฑ์");

      // Append Sheet 2: รายละเอียดแยกสถานีและหมู่บ้าน
      const wsDetailed = XLSX.utils.json_to_sheet(detailedRows);
      wsDetailed['!cols'] = [
        { wch: 8 },  // ลำดับ
        { wch: 40 }, // รายการชุดอุปกรณ์หลัก
        { wch: 32 }, // สถานี / ชุดควบคุม / จังหวัด
        { wch: 45 }, // หมู่บ้าน / จุดติดตั้ง
        { wch: 38 }, // ชุดอุปกรณ์ย่อย
        { wch: 16 }, // ยี่ห้อ
        { wch: 28 }, // Model
        { wch: 24 }, // Serial
        { wch: 10 }  // จำนวน
      ];
      XLSX.utils.book_append_sheet(wb, wsDetailed, "รายละเอียดแยกสถานีและหมู่บ้าน");

      // Append Sheet 3: สรุปภาพรวมตามชุดหลัก
      const wsOverview = XLSX.utils.json_to_sheet(overviewRows);
      wsOverview['!cols'] = [
        { wch: 8 },  // ลำดับ
        { wch: 50 }, // รายการชุดอุปกรณ์หลัก
        { wch: 22 }, // จำนวนสถานี/ชุดย่อย
        { wch: 22 }, // จำนวนรายการอุปกรณ์
        { wch: 22 }  // จำนวนเครื่องรวม
      ];
      XLSX.utils.book_append_sheet(wb, wsOverview, "สรุปยอดตามชุดหลัก");

      const dateStr = new Date().toISOString().slice(0, 10);
      XLSX.writeFile(wb, `รายงานสรุปบัญชีครุภัณฑ์_FORTH_USO_${dateStr}.xlsx`);
      showToast(`สรุปรายงานและส่งออกไฟล์ Excel สำเร็จ (${summaryRows.length} รายการ)`);
    }

    function openReportModal() {
      const modal = document.getElementById('reportModal');
      if (modal) {
        modal.classList.remove('hidden');
        const groups = groupItemsIntoSets(currentData);
        populatePdfModalDropdown(groups);
      }
    }

    function closeReportModal() {
      const modal = document.getElementById('reportModal');
      if (modal) modal.classList.add('hidden');
    }

    // ==========================================
    // PDF PRINT GENERATOR & MODAL HANDLERS
    // รองรับ 1.1-1.2, 2.1, 3.1-3.8, 4.1-4.8, 5 รายหมู่บ้าน, 6.1-6.2
    // ==========================================

    // Populates PDF target dropdown in Report Modal
    function populatePdfModalDropdown(groups) {
      const select = document.getElementById('pdfTargetSelect');
      if (!select) return;

      let html = '<option value="">-- กรุณาเลือกชุดอุปกรณ์ หรือ รายชื่อหมู่บ้านที่ต้องการพิมพ์ --</option>';

      groups.forEach(g => {
        const hasVillages = g.subGroups && g.subGroups.some(sg => sg.villageUnits && sg.villageUnits.length > 0);

        if (hasVillages) {
          // Section 5: วิทยุลูกข่ายประจำที่ (แยกรายจังหวัด และรายหมู่บ้าน)
          html += `<optgroup label="หมวด ${g.no}. ${g.title} (รายหมู่บ้าน)">`;
          g.subGroups.forEach(sg => {
            if (sg.villageUnits && sg.villageUnits.length > 0) {
              html += `<option value="PROV_${sg.id}" class="font-bold text-sky-800">📂 [พิมพ์ทุกหมู่บ้านใน ${sg.title}] (${sg.villageUnits.length} หมู่บ้าน)</option>`;
              sg.villageUnits.forEach(vil => {
                html += `<option value="VIL_${vil.id}">&nbsp;&nbsp;&nbsp;&nbsp;📍 ${vil.no} ${vil.title}</option>`;
              });
            }
          });
          html += `</optgroup>`;
        } else if (g.subGroups && g.subGroups.length > 0) {
          // Sections 1, 2, 3, 4, 6, 7
          html += `<optgroup label="หมวด ${g.no}. ${g.title}">`;
          html += `<option value="SEC_${g.id}" class="font-bold text-sky-800">📑 [พิมพ์ทั้งหมวด] ${g.no}. ${g.title} (${g.subGroups.length} ชุดย่อย)</option>`;
          g.subGroups.forEach(sg => {
            const count = (sg.items || []).length;
            html += `<option value="SUB_${sg.id}">&nbsp;&nbsp;&nbsp;&nbsp;📁 ${sg.no} ${sg.title} (${count} รายการ)</option>`;
          });
          if (g.directItems && g.directItems.length > 0) {
            html += `<option value="DIR_${g.id}">&nbsp;&nbsp;&nbsp;&nbsp;📦 ${g.no} รายการอุปกรณ์ในตู้ (${g.directItems.length} รายการ)</option>`;
          }
          html += `</optgroup>`;
        } else if (g.directItems && g.directItems.length > 0) {
          html += `<optgroup label="หมวด ${g.no}. ${g.title}">`;
          html += `<option value="DIR_${g.id}">📦 ${g.no} รายการอุปกรณ์ในตู้ (${g.directItems.length} รายการ)</option>`;
          html += `</optgroup>`;
        }
      });

      select.innerHTML = html;
      handlePdfSelectChange();
    }

    // Handles dropdown selection change in Report Modal
    function handlePdfSelectChange() {
      const select = document.getElementById('pdfTargetSelect');
      const btnBatch = document.getElementById('btnBatchPrintVil');
      const btnBatchText = document.getElementById('btnBatchPrintVilText');
      if (!select || !btnBatch) return;

      const val = select.value || '';
      if (val.startsWith('PROV_')) {
        btnBatch.classList.remove('hidden');
        const data = findSubGroupData(val.replace('PROV_', ''));
        btnBatchText.textContent = `พิมพ์ทุกหมู่บ้านใน ${data ? data.subGroup.title : 'จังหวัดนี้'}`;
      } else if (val.startsWith('VIL_')) {
        btnBatch.classList.remove('hidden');
        const data = findVillageData(val.replace('VIL_', ''));
        btnBatchText.textContent = `พิมพ์ทุกหมู่บ้านใน ${data ? data.subGroup.title : 'จังหวัดเดียวกัน'}`;
      } else {
        btnBatch.classList.add('hidden');
      }
    }

    // Handle print triggered from modal
    function handlePrintFromModal() {
      const select = document.getElementById('pdfTargetSelect');
      if (!select || !select.value) {
        showToast('กรุณาเลือกชุดอุปกรณ์หรือหมู่บ้านที่ต้องการพิมพ์ก่อน');
        return;
      }
      const val = select.value;
      closeReportModal();

      if (val.startsWith('VIL_')) {
        printVillagePdf(val.replace('VIL_', ''));
      } else if (val.startsWith('PROV_')) {
        printProvinceAllVillages(val.replace('PROV_', ''));
      } else if (val.startsWith('SUB_')) {
        printSubGroupPdf(val.replace('SUB_', ''));
      } else if (val.startsWith('SEC_')) {
        printSectionPdf(val.replace('SEC_', ''));
      } else if (val.startsWith('DIR_')) {
        printDirectItemsPdf(val.replace('DIR_', ''));
      }
    }

    // Handle batch print villages from modal
    function handleBatchPrintVillages() {
      const select = document.getElementById('pdfTargetSelect');
      if (!select || !select.value) return;
      const val = select.value;

      if (val.startsWith('PROV_')) {
        closeReportModal();
        printProvinceAllVillages(val.replace('PROV_', ''));
      } else if (val.startsWith('VIL_')) {
        closeReportModal();
        const data = findVillageData(val.replace('VIL_', ''));
        if (data) {
          printProvinceAllVillages(data.subGroup.id);
        }
      }
    }

    // Lookup helper for SubGroup
    function findSubGroupData(subId) {
      const groups = groupItemsIntoSets(currentData);
      for (const g of groups) {
        if (g.subGroups) {
          const sg = g.subGroups.find(s => s.id === subId || s.no === subId);
          if (sg) {
            return { section: g, subGroup: sg, items: sg.items || sg.displayedItems || [] };
          }
        }
      }
      return null;
    }

    // Lookup helper for Village
    function findVillageData(vilId) {
      const groups = groupItemsIntoSets(currentData);
      for (const g of groups) {
        if (g.subGroups) {
          for (const sg of g.subGroups) {
            if (sg.villageUnits) {
              const vil = sg.villageUnits.find(v => v.id === vilId || v.no === vilId);
              if (vil) {
                return { section: g, subGroup: sg, village: vil, items: vil.items || vil.displayedItems || [] };
              }
            }
          }
        }
      }
      return null;
    }

    // Print SubGroup PDF (e.g. 1.1, 1.2, 2.1, 3.1-3.8, 4.1-4.8, 6.1, 6.2, 7.1)
    function printSubGroupPdf(subId) {
      const data = findSubGroupData(subId);
      if (!data) {
        showToast('ไม่พบข้อมูลชุดอุปกรณ์ที่ต้องการพิมพ์');
        return;
      }

      if (data.subGroup.villageUnits && data.subGroup.villageUnits.length > 0) {
        printProvinceAllVillages(subId);
        return;
      }

      const cleanTitle = (data.subGroup.title || '').replace(/#/g, '').trim();
      const pageHtml = generateSingleSheetHtml({
        sectionNo: data.section.no,
        sectionTitle: data.section.title,
        unitNo: data.subGroup.no,
        unitTitle: cleanTitle,
        locationInfo: cleanTitle,
        items: data.items,
        isVillage: false,
        pageInfo: `ชุดอุปกรณ์ลำดับที่ ${data.subGroup.no}`
      });

      const fullDoc = wrapInPrintDocument(`${data.subGroup.no} ${cleanTitle} - ใบรายการบัญชีครุภัณฑ์`, pageHtml);
      executePrint(fullDoc);
    }

    // Print Village PDF (under Section 5: 5.1.1, 5.1.2 ...)
    function printVillagePdf(vilId) {
      const data = findVillageData(vilId);
      if (!data) {
        showToast('ไม่พบข้อมูลหมู่บ้านที่ต้องการพิมพ์');
        return;
      }

      const cleanVilTitle = (data.village.title || '').replace(/#/g, '').trim().replace(/^[\d.]+\s*/, '');
      const cleanProvTitle = (data.subGroup.title || '').replace(/#/g, '').trim();

      const pageHtml = generateSingleSheetHtml({
        sectionNo: data.section.no,
        sectionTitle: `${data.section.title} (${cleanProvTitle})`,
        unitNo: data.village.no,
        unitTitle: cleanVilTitle,
        locationInfo: `${cleanVilTitle} &bull; ${cleanProvTitle}`,
        items: data.items,
        isVillage: true,
        pageInfo: `จุดติดตั้งประจำหมู่บ้าน ลำดับที่ ${data.village.no}`
      });

      const fullDoc = wrapInPrintDocument(`${data.village.no} ${cleanVilTitle} - ใบรายการบัญชีครุภัณฑ์`, pageHtml);
      executePrint(fullDoc);
    }

    // Print all villages in a province (Section 5 batch print)
    function printProvinceAllVillages(subId) {
      const data = findSubGroupData(subId);
      if (!data || !data.subGroup.villageUnits || data.subGroup.villageUnits.length === 0) {
        showToast('ไม่พบข้อมูลหมู่บ้านในจังหวัดนี้');
        return;
      }

      const cleanProvTitle = (data.subGroup.title || '').replace(/#/g, '').trim();
      const totalVils = data.subGroup.villageUnits.length;

      const pagesHtml = data.subGroup.villageUnits.map((vil, vIdx) => {
        const cleanVilTitle = (vil.title || '').replace(/#/g, '').trim().replace(/^[\d.]+\s*/, '');
        return generateSingleSheetHtml({
          sectionNo: data.section.no,
          sectionTitle: `${data.section.title} (${cleanProvTitle})`,
          unitNo: vil.no,
          unitTitle: cleanVilTitle,
          locationInfo: `${cleanVilTitle} &bull; ${cleanProvTitle}`,
          items: vil.items || vil.displayedItems || [],
          isVillage: true,
          pageInfo: `หมู่บ้านที่ ${vIdx + 1}/${totalVils} (${cleanProvTitle})`
        });
      }).join('');

      const fullDoc = wrapInPrintDocument(`${cleanProvTitle} - พิมพ์ทุกหมู่บ้าน (${totalVils} ชุด)`, pagesHtml);
      executePrint(fullDoc);
    }

    // Print Section Direct Items PDF (e.g. SD-WAN Cabinet direct items)
    function printDirectItemsPdf(groupId) {
      const groups = groupItemsIntoSets(currentData);
      const g = groups.find(x => x.id === groupId || String(x.no) === String(groupId));
      if (!g || !g.directItems || g.directItems.length === 0) {
        showToast('ไม่พบรายการอุปกรณ์ในตู้');
        return;
      }

      const cleanSecTitle = (g.title || '').replace(/#/g, '').trim();
      const pageHtml = generateSingleSheetHtml({
        sectionNo: g.no,
        sectionTitle: cleanSecTitle,
        unitNo: g.no,
        unitTitle: 'รายการอุปกรณ์ในตู้ระบบ',
        locationInfo: cleanSecTitle,
        items: g.directItems,
        isVillage: false,
        pageInfo: `หมวด ${g.no}. ${cleanSecTitle} (รายการอุปกรณ์ในตู้)`
      });

      const fullDoc = wrapInPrintDocument(`${g.no}. ${cleanSecTitle} - ใบรายการบัญชีครุภัณฑ์`, pageHtml);
      executePrint(fullDoc);
    }

    // Print entire Section PDF (combines all subGroups/villages with page breaks)
    function printSectionPdf(groupId) {
      const groups = groupItemsIntoSets(currentData);
      const g = groups.find(x => x.id === groupId || String(x.no) === String(groupId));
      if (!g) {
        showToast('ไม่พบข้อมูลหมวดที่ต้องการพิมพ์');
        return;
      }

      const cleanSecTitle = (g.title || '').replace(/#/g, '').trim();

      // Check if Section 5 with villages
      const hasVillages = g.subGroups && g.subGroups.some(sg => sg.villageUnits && sg.villageUnits.length > 0);
      if (hasVillages) {
        let allVils = [];
        g.subGroups.forEach(sg => {
          if (sg.villageUnits) {
            sg.villageUnits.forEach(v => allVils.push({ vil: v, subGroup: sg }));
          }
        });

        const pagesHtml = allVils.map((item, idx) => {
          const cleanVilTitle = (item.vil.title || '').replace(/#/g, '').trim().replace(/^[\d.]+\s*/, '');
          const cleanProvTitle = (item.subGroup.title || '').replace(/#/g, '').trim();
          return generateSingleSheetHtml({
            sectionNo: g.no,
            sectionTitle: `${cleanSecTitle} (${cleanProvTitle})`,
            unitNo: item.vil.no,
            unitTitle: cleanVilTitle,
            locationInfo: `${cleanVilTitle} &bull; ${cleanProvTitle}`,
            items: item.vil.items || item.vil.displayedItems || [],
            isVillage: true,
            pageInfo: `หมู่บ้านที่ ${idx + 1}/${allVils.length}`
          });
        }).join('');

        const fullDoc = wrapInPrintDocument(`${cleanSecTitle} - รายการครุภัณฑ์รายหมู่บ้าน (${allVils.length} หมู่)`, pagesHtml);
        executePrint(fullDoc);
        return;
      }

      // Standard subGroups
      let allPages = [];
      if (g.subGroups && g.subGroups.length > 0) {
        g.subGroups.forEach((sg, idx) => {
          const cleanSgTitle = (sg.title || '').replace(/#/g, '').trim();
          allPages.push(generateSingleSheetHtml({
            sectionNo: g.no,
            sectionTitle: cleanSecTitle,
            unitNo: sg.no,
            unitTitle: cleanSgTitle,
            locationInfo: cleanSgTitle,
            items: sg.items || sg.displayedItems || [],
            isVillage: false,
            pageInfo: `ชุดที่ ${idx + 1}/${g.subGroups.length} &bull; หมวด ${g.no}`
          }));
        });
      }

      if (g.directItems && g.directItems.length > 0) {
        allPages.push(generateSingleSheetHtml({
          sectionNo: g.no,
          sectionTitle: cleanSecTitle,
          unitNo: g.no,
          unitTitle: 'รายการอุปกรณ์ในตู้ระบบ',
          locationInfo: cleanSecTitle,
          items: g.directItems,
          isVillage: false,
          pageInfo: `รายการอุปกรณ์ในตู้ &bull; หมวด ${g.no}`
        }));
      }

      if (allPages.length === 0) {
        showToast('ไม่มีรายการอุปกรณ์ในหมวดนี้');
        return;
      }

      const fullDoc = wrapInPrintDocument(`${g.no}. ${cleanSecTitle} - ใบรายการบัญชีครุภัณฑ์`, allPages.join(''));
      executePrint(fullDoc);
    }

    // Builds a single A4 sheet HTML
    function generateSingleSheetHtml({
      sectionNo = "",
      sectionTitle = "",
      unitNo = "",
      unitTitle = "",
      locationInfo = "",
      items = [],
      isVillage = false,
      pageInfo = ""
    }) {
      const printDateStr = new Date().toLocaleDateString('th-TH', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });

      const rowsHtml = items.map((it, idx) => {
        const snVal = (it.sn && it.sn !== '-' && it.sn.trim() !== '') ? it.sn : '-';
        const modelVal = (it.model && it.model !== '-' && it.model.trim() !== '') ? it.model : '-';
        const brandVal = (it.brand && it.brand !== '-' && it.brand.trim() !== '') ? it.brand : '-';
        const cleanName = (it.name || '').replace(/^[-*•↳\s]+/, '').trim();

        return `
          <tr>
            <td class="text-center" style="width: 44px; font-weight: 600; color: #0f172a;">${idx + 1}</td>
            <td style="font-weight: 600; color: #0f172a;">
              ${cleanName}
            </td>
            <td class="text-center" style="width: 85px; font-weight: 600; color: #0f172a;">
              ${brandVal}
            </td>
            <td style="width: 175px; font-weight: 600; color: #0f172a;">
              ${modelVal}
            </td>
            <td style="width: 175px; font-weight: 600; color: #0f172a; font-family: inherit;">
              ${snVal}
            </td>
            <td class="text-center" style="width: 50px; font-weight: 700; color: #0f172a;">${it.qty || '1'}</td>
          </tr>
        `;
      }).join('');

      const logoEl = document.querySelector('img[src*="forth-logo"]');
      const logoSrc = (logoEl && logoEl.src) ? logoEl.src : 'forth-logo.png';

      return `
        <div class="sheet-page">
          <!-- Header Table -->
          <table class="header-table">
            <tr>
              <td style="white-space: nowrap; vertical-align: middle;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <img src="${logoSrc}" alt="FORTH Logo" class="logo-img" onerror="this.style.display='none'">
                  <div>
                    <div class="company-title">บริษัท ฟอร์ท คอร์ปอเรชั่น จำกัด (มหาชน)</div>
                    <div class="company-sub">FORTH CORPORATION PUBLIC COMPANY LIMITED</div>
                  </div>
                </div>
              </td>
              <td style="text-align: right; white-space: nowrap; vertical-align: middle; padding-right: 4px;">
                <h1 class="doc-main-title">ใบรายการบัญชีครุภัณฑ์</h1>
              </td>
            </tr>
          </table>

          <!-- Meta Details Box -->
          <div class="meta-box">
            <div class="meta-title">${unitTitle}</div>
          </div>

          <!-- Equipment Table -->
          <table class="data-table">
            <thead>
              <tr>
                <th class="text-center" style="width: 44px;">ลำดับ</th>
                <th class="text-center">รายการอุปกรณ์ (Equipment Description)</th>
                <th class="text-center" style="width: 85px;">ยี่ห้อ</th>
                <th style="width: 175px;">รุ่น (Model)</th>
                <th style="width: 175px;">หมายเลขประจำเครื่อง (S/N)</th>
                <th class="text-center" style="width: 50px;">จำนวน</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml || '<tr><td colspan="6" class="text-center" style="padding: 16px; color: #94a3b8;">ไม่มีรายการอุปกรณ์ในชุดนี้</td></tr>'}
            </tbody>
          </table>
        </div>
      `;
    }

    // Wraps printable HTML body into full document
    function wrapInPrintDocument(title, bodyContent) {
      return `<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>${title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
  <style>
    @page {
      size: A4 portrait;
      margin: 0;
    }
    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body {
      font-family: 'Sarabun', 'TH Sarabun New', 'TH Sarabun PSK', sans-serif;
      font-size: 13px;
      line-height: 1.35;
      color: #0f172a;
      background: #ffffff;
      margin: 0;
      padding: 0;
    }
    .sheet-page {
      padding: 12mm 15mm 12mm 15mm;
      box-sizing: border-box;
      page-break-after: always;
      break-after: page;
    }
    .sheet-page:last-child {
      page-break-after: auto;
      break-after: auto;
    }
    .header-table {
      width: 100%;
      border-collapse: collapse;
      border-bottom: 2.5px solid #0284c7;
      padding-bottom: 6px;
      margin-bottom: 10px;
    }
    .header-table td {
      vertical-align: middle;
      border: none !important;
      padding: 0;
    }
    .logo-img {
      height: 36px;
      width: auto;
      display: block;
    }
    .company-title {
      font-size: 14.5px;
      font-weight: 700;
      color: #0f172a;
      line-height: 1.25;
      white-space: nowrap;
    }
    .company-sub {
      font-size: 10px;
      color: #64748b;
      letter-spacing: 0.2px;
      line-height: 1.25;
      margin-top: 2px;
      white-space: nowrap;
    }
    .doc-main-title {
      font-size: 17px;
      font-weight: 800;
      color: #0369a1;
      text-align: right;
      margin: 0;
      line-height: 1.2;
      white-space: nowrap;
    }
    .meta-box {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-left: 5px solid #0284c7;
      border-radius: 6px;
      padding: 7px 12px;
      margin-bottom: 10px;
    }
    .meta-title {
      font-size: 14px;
      font-weight: 700;
      color: #0f172a;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
    }
    table.data-table th {
      background-color: #f1f5f9 !important;
      color: #1e293b;
      font-weight: 700;
      font-size: 12px;
      border: 1px solid #94a3b8;
      padding: 5px 6px;
      text-align: left;
    }
    table.data-table td {
      border: 1px solid #cbd5e1;
      padding: 4.5px 6px;
      font-size: 12px;
      color: #1e293b;
      vertical-align: middle;
    }
    table.data-table tr:nth-child(even) {
      background-color: #f8fafc;
    }
    .text-center { text-align: center !important; }
    .font-bold { font-weight: 700; }
    .badge {
      display: inline-block;
      padding: 1px 4px;
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      border-radius: 3px;
      font-size: 11.5px;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  ${bodyContent}
</body>
</html>`;
    }

    // Hidden iframe print executor
    function executePrint(printableHtml) {
      showToast("กำลังเปิดหน้าต่างพิมพ์เอกสาร PDF (A4)...");

      let iframe = document.getElementById('printHiddenFrame');
      if (!iframe) {
        iframe = document.createElement('iframe');
        iframe.id = 'printHiddenFrame';
        iframe.style.position = 'fixed';
        iframe.style.right = '0';
        iframe.style.bottom = '0';
        iframe.style.width = '0';
        iframe.style.height = '0';
        iframe.style.border = 'none';
        iframe.style.opacity = '0';
        iframe.style.pointerEvents = 'none';
        document.body.appendChild(iframe);
      }

      const doc = iframe.contentWindow.document;
      doc.open();
      doc.write(printableHtml);
      doc.close();

      setTimeout(() => {
        try {
          iframe.contentWindow.focus();
          iframe.contentWindow.print();
        } catch (e) {
          console.warn("Iframe print blocked, falling back to popup window", e);
          const printWin = window.open('', '_blank');
          if (printWin) {
            printWin.document.write(printableHtml);
            printWin.document.close();
            setTimeout(() => {
              printWin.focus();
              printWin.print();
            }, 500);
          }
        }
      }, 400);
    }

    function downloadExcelTemplate() {
      const templateRows = [
        { "ลำดับ": "1", "รายการชุดอุปกรณ์หลัก": "ชุดอุปกรณ์ระบบศูนย์ควบคุมสถานีแม่ข่าย (BSSC)", "ชุดอุปกรณ์ย่อย": "S/N ชุดควบคุมสถานีแม่ข่าย IPN (1) : อุปกรณ์ XGN Server 7", "Model": "ThinkSystem SR250 V3", "Serial": "J902T9K3", "จำนวน": "1" },
        { "ลำดับ": "2", "รายการชุดอุปกรณ์หลัก": "ชุดอุปกรณ์ระบบศูนย์ควบคุมสถานีแม่ข่าย (BSSC)", "ชุดอุปกรณ์ย่อย": "S/N ชุดควบคุมสถานีแม่ข่าย IPN (1) : อุปกรณ์ NDB Server A", "Model": "ThinkSystem SR250 V3", "Serial": "J902GKZ6", "จำนวน": "1" },
        { "ลำดับ": "3", "รายการชุดอุปกรณ์หลัก": "ชุดอุปกรณ์สถานี Analog Gateway", "ชุดอุปกรณ์ย่อย": "ที่ว่าการอำเภอห้วยกระเจา : สายอากาศแบบทิศทาง (Microwave)", "Model": "A7WD09MAC-3NX", "Serial": "2152432583L0RC030008", "จำนวน": "1" },
        { "ลำดับ": "4", "รายการชุดอุปกรณ์หลัก": "ชุดอุปกรณ์สถานี Analog Gateway", "ชุดอุปกรณ์ย่อย": "ที่ว่าการอำเภอห้วยกระเจา : อุปกรณ์ ODU", "Model": "XMC-7G-3E", "Serial": "215241502710RC100001", "จำนวน": "1" },
        { "ลำดับ": "5", "รายการชุดอุปกรณ์หลัก": "ชุดอุปกรณ์สถานีแม่ข่ายแบบ 1 Carriers", "ชุดอุปกรณ์ย่อย": "BS หนองนกแก้ว : Base station", "Model": "DIB-R5OUTDOOR800", "Serial": "-", "จำนวน": "1" }
      ];

      const wb = XLSX.utils.book_new();
      const ws = XLSX.utils.json_to_sheet(templateRows);
      ws['!cols'] = [
        { wch: 8 },
        { wch: 45 },
        { wch: 55 },
        { wch: 25 },
        { wch: 24 },
        { wch: 10 }
      ];
      XLSX.utils.book_append_sheet(wb, ws, "Template_สรุปครุภัณฑ์");
      XLSX.writeFile(wb, "ตัวอย่างแบบฟอร์ม_สรุปบัญชีครุภัณฑ์_FORTH.xlsx");
      showToast("ดาวน์โหลดไฟล์ตัวอย่างแบบฟอร์ม Excel เรียบร้อยแล้ว");
    }

    function copyToClipboard(text) {
      if (!text || text === '-') return;
      navigator.clipboard.writeText(text).then(() => {
        showToast(`คัดลอกหมายเลข Serial Number: ${text} แล้ว`);
      }).catch(() => {
        showToast('ไม่สามารถคัดลอกข้อความได้');
      });
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.textContent = msg;
      
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    }

    // Helper: Update Data Source Badge
    function updateSourceBadge(fileName) {
      const sourceNameEl = document.getElementById('sourceName');
      if (sourceNameEl) {
        sourceNameEl.textContent = fileName;
      }
    }

    window.addEventListener('click', function(e) {
      const modal1 = document.getElementById('detailModal');
      const modal2 = document.getElementById('excelModal');
      const modal3 = document.getElementById('reportModal');
      if (e.target === modal1) closeModal();
      if (e.target === modal2) closeExcelModal();
      if (e.target === modal3) closeReportModal();
    });
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeModal();
        closeExcelModal();
        closeReportModal();
      }
    });

    // ==========================================
    // 7. CHARTS FUNCTION (REMOVED AS REQUESTED)
    // ==========================================
    function updateCharts(groups) {
      // กราฟแสดงผลถูกนำออกตามความต้องการของผู้ใช้งาน
    }

    // Start App
    window.addEventListener('DOMContentLoaded', () => {
      initData();
      // Auto-sync live data immediately from Google Sheets
      syncFromGoogleSheets(false);
      // Start real-time auto-sync loop with visible 30s countdown
      startAutoSyncLoop();
      try {
        const params = new URLSearchParams(window.location.search);
        const view = params.get('view');
        if (view === 'flat') {
          setViewMode('FLAT');
        }
        const sec = params.get('sec');
        const sub = params.get('sub');
        if (sec) {
          const groups = groupItemsIntoSets(currentData);
          const targetGroup = groups.find(g => String(g.no) === String(sec));
          if (targetGroup) {
            const toolbarSub = document.getElementById('subTopicToolbarSelect');
            if (toolbarSub) {
              toolbarSub.value = 'SEC_' + targetGroup.id;
              handleToolbarSubFilter();
            }
          }
        }
        if (sub) {
          const groups = groupItemsIntoSets(currentData);
          for (const g of groups) {
            const sg = g.subGroups && g.subGroups.find(s => s.id === sub || s.no === sub);
            if (sg) {
              handleSubGroupFilter(g.id, sg.id);
              const vil = params.get('vil');
              if (vil && sg.villageUnits && sg.villageUnits.length > 0) {
                const targetVil = sg.villageUnits.find(v => v.id === vil || v.no === vil) || sg.villageUnits[0];
                if (targetVil) {
                  expandedVillageIds.add(targetVil.id);
                  renderGroupedView(groups);
                }
              }
              break;
            }
          }
        }
      } catch (e) {
        console.error(e);
      }
    });
  </script>

</body>
</html>
