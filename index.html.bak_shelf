<!DOCTYPE html>
<html lang="th" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FORTH Dashboard (USO SHF)</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Font Awesome 6.5.1 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  
  <!-- SheetJS (xlsx) for reading/writing Excel files -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

  <!-- Google Fonts: Sarabun (Thai Sarabun) & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Sarabun', 'TH Sarabun New', 'TH Sarabun PSK', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              200: '#bae6fd',
              300: '#7dd3fc',
              400: '#38bdf8',
              500: '#0ea5e9',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            },
            silver: {
              50: '#f8fafc',
              100: '#f1f5f9',
              200: '#e2e8f0',
              300: '#cbd5e1',
              400: '#94a3b8',
              500: '#64748b',
              600: '#475569',
              700: '#334155',
              800: '#1e293b',
              900: '#0f172a',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Sarabun', 'TH Sarabun New', 'TH Sarabun PSK', sans-serif;
      font-size: 16px;
      line-height: 1.6;
      letter-spacing: 0.01em;
      background-color: #080e1e;
      background-image: 
        linear-gradient(rgba(8, 14, 30, 0.94), rgba(15, 23, 42, 0.97)),
        url('background.jpg');
      background-attachment: fixed;
      background-size: cover;
      background-position: center;
      min-height: 100vh;
    }

    /* Compact & Elegant Banner Header - โทน ดำ น้ำเงิน เงิน */
    .hero-banner-compact {
      background-image: 
        linear-gradient(to right, rgba(8, 14, 30, 0.95) 0%, rgba(15, 23, 42, 0.75) 45%, rgba(15, 23, 42, 0.30) 100%),
        url('background.jpg');
      background-size: cover;
      background-position: center 28%;
    }

    /* Custom Glassmorphism Effect: White with Silver Border */
    .glass-card {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(226, 232, 240, 0.95);
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    /* Drag & Drop Zone Styling */
    .dropzone-active {
      border-color: #0284c7 !important;
      background-color: rgba(2, 132, 199, 0.08) !important;
    }

    /* Set Tree Connector styling */
    .tree-connector {
      position: relative;
    }
    .tree-connector::before {
      content: '';
      position: absolute;
      left: 18px;
      top: -12px;
      bottom: 50%;
      width: 12px;
      border-left: 2px dashed #cbd5e1;
      border-bottom: 2px dashed #cbd5e1;
      border-bottom-left-radius: 6px;
    }

    /* Dropdown select font size for readability */
    select, select option, select optgroup {
      font-family: 'Sarabun', 'TH Sarabun New', 'TH Sarabun PSK', sans-serif !important;
      font-size: 13px !important;
      line-height: 1.4 !important;
    }

    /* Print styling */
    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      .no-print {
        display: none !important;
      }
      .hero-banner-compact {
        background: none !important;
        color: #000000 !important;
      }
      .glass-card {
        box-shadow: none !important;
        border: 1px solid #cbd5e1 !important;
        page-break-inside: avoid;
      }
    }

    /* Animation */
    .fade-in {
      animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="text-slate-800 antialiased flex flex-col min-h-screen">

  <!-- COMPACT & ELEGANT HERO BANNER -->
  <header class="hero-banner-compact text-white shadow-xl relative overflow-hidden border-b border-slate-700/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-6 relative z-10 flex flex-col justify-between">
      
      <!-- Top Row: Spacer for FORTH logo on image (left) & Actions (right) -->
      <div class="flex items-center justify-between gap-4 mb-3">
        
        <!-- FORTH Official Brand Logo Badge (Top-Left) -->
        <div class="flex items-center gap-3 bg-white/95 backdrop-blur-md px-4 py-2 rounded-xl shadow-lg border border-slate-200 group hover:shadow-xl transition-all duration-200">
          <img src="forth-logo.png" alt="FORTH CORPORATION Logo" class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105">
          <div class="h-7 w-px bg-slate-200 hidden sm:block"></div>
          <div class="hidden sm:flex flex-col justify-center text-left">
            <span class="text-xs sm:text-[13px] font-bold text-slate-800 tracking-normal leading-tight">FORTH CORPORATION</span>
            <span class="text-[10px] sm:text-[11px] font-semibold text-slate-500 uppercase tracking-wider leading-tight mt-0.5">PUBLIC COMPANY LIMITED</span>
          </div>
        </div>

        <!-- Quick Action Buttons: Blue, Silver, Black, White (Compact & Elegant) -->
        <div class="flex flex-wrap items-center gap-1.5 no-print">
          <!-- Button: Google Sheets Live Sync & Direct Link -->
          <div class="inline-flex rounded-lg shadow-sm shadow-sky-600/20 overflow-hidden border border-sky-400/40 bg-slate-900/90 backdrop-blur-md">
            <button 
              id="btnSyncGoogleSheet"
              onclick="syncFromGoogleSheets(true)" 
              title="ระบบกำลังซิงค์อัตโนมัติทุก 30 วินาที (คลิกเพื่อบังคับซิงค์เดี๋ยวนี้)"
              class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white transition-all duration-200"
            >
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
              </span>
              <i id="syncIcon" class="fa-solid fa-arrows-rotate text-[11px] text-sky-100"></i>
              <span id="syncText">ซิงค์ Google Sheets อัตโนมัติ</span>
              <span id="syncCountdown" class="text-[11px] text-sky-200 font-mono font-normal">(30s)</span>
            </button>
            <a 
              href="https://docs.google.com/spreadsheets/d/1NZrR_0i54ynjmTmXuEgCxTsC53jDNEdSl_dYe_sc_pU/edit?usp=sharing" 
              target="_blank" 
              rel="noopener noreferrer" 
              title="เปิดดูและแก้ไขไฟล์ Google Sheets ต้นฉบับ (จะซิงค์มาที่นี่อัตโนมัติ)"
              class="px-2.5 py-1.5 bg-sky-700 hover:bg-sky-600 text-sky-100 border-l border-sky-500/50 flex items-center justify-center transition-colors"
            >
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>

          <!-- Secondary Button: Manual Excel Upload Modal -->
          <button onclick="openExcelModal()" title="อัปโหลดไฟล์ Excel จากเครื่องคอมพิวเตอร์" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700 transition-all duration-200">
            <i class="fa-solid fa-file-excel text-xs text-sky-400"></i>
            <span>ไฟล์ Excel</span>
          </button>

          <!-- Button: Export to Excel/CSV -->
          <button onclick="exportExcelSummaryReport()" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900/90 hover:bg-slate-800 text-white border border-slate-700 backdrop-blur-md shadow transition-all duration-200 hover:-translate-y-0.5">
            <i class="fa-solid fa-file-excel text-xs text-sky-400"></i>
            <span>ส่งออก Excel</span>
          </button>
          
          <!-- Button: Print Report -->
          <div class="relative inline-flex rounded-lg shadow-sm border border-slate-700 overflow-hidden">
            <button onclick="exportExcelSummaryReport()" title="คลิกเพื่อสรุปรายงานเป็นไฟล์ Excel ทันที" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-white transition-all duration-200">
              <i class="fa-solid fa-print text-xs text-sky-300"></i>
              <span>พิมพ์รายงาน</span>
            </button>
            <button onclick="openReportModal()" title="ตัวเลือกพิมพ์รายงาน / สั่งพิมพ์ PDF" class="px-2 py-1.5 text-xs font-semibold bg-slate-900 hover:bg-slate-800 text-slate-300 border-l border-slate-700 transition-all duration-200">
              <i class="fa-solid fa-chevron-down text-[10px]"></i>
            </button>
          </div>
        </div>

      </div>

      <!-- Main Title Block (Clean, Modern, Compact) -->
      <div class="max-w-full space-y-2.5">
        
        <!-- Badges Strip: Blue, Silver, Black -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-xs sm:text-[13px] font-semibold bg-sky-500/25 text-sky-200 border border-sky-400/30 backdrop-blur-md">
            <i class="fa-solid fa-file-contract text-sky-400 text-xs"></i>
            สัญญาเลขที่ 8680228
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-xs sm:text-[13px] font-medium bg-slate-800/80 text-slate-200 border border-slate-600/60 backdrop-blur-md">
            <i class="fa-solid fa-calendar-check text-slate-300 text-xs"></i>
            23 กรกฎาคม 2568
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-xs sm:text-[13px] font-medium bg-blue-600/30 text-blue-200 border border-blue-400/30 backdrop-blur-md">
            <i class="fa-solid fa-tower-cell text-blue-300 text-xs"></i>
            USO SHF 
          </span>
          <a href="https://docs.google.com/spreadsheets/d/1NZrR_0i54ynjmTmXuEgCxTsC53jDNEdSl_dYe_sc_pU/edit?usp=sharing" target="_blank" id="sourceBadge" class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs sm:text-[13px] font-semibold bg-slate-900/90 text-sky-300 border border-slate-700 backdrop-blur-md hover:border-sky-400 transition-colors" title="คลิกเพื่อเปิด Google Sheets">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="sourceName">ซิงค์ Google Sheets อัตโนมัติ</span>
          </a>
        </div>

        <!-- Heading -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-normal text-white leading-tight drop-shadow">
          บัญชีรายการครุภัณฑ์
        </h1>

        <!-- Subtitle: Project name (Line 1) and Company name (Line 2 below) -->
        <div class="space-y-0.5 drop-shadow max-w-full">
          <p class="text-sm sm:text-base text-slate-200 font-medium whitespace-nowrap">
            โครงการเพิ่มประสิทธิภาพระบบโครงข่ายสื่อสารด้วยอุปกรณ์ทวนสัญญาณผ่านคลื่นความถี่สูง (SHF)
          </p>
          <p class="text-xs sm:text-sm text-slate-400 whitespace-nowrap">
            บริษัท ฟอร์ท คอร์ปอเรชั่น จำกัด (มหาชน)
          </p>
        </div>

      </div>

    </div>
  </header>

  <!-- MAIN DASHBOARD CONTENT -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full flex-grow space-y-6">

    <!-- STAT CARDS (3-GRID) - ธีม ฟ้า ขาว เงิน (Blue, White, Silver) -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      
      <!-- Card 1: Manufacturer / Primary Brand (ผู้บริหารโครงการ - FORTH) -->
      <div class="glass-card rounded-2xl p-5 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 relative overflow-hidden group border border-slate-200/80 hover:border-sky-300">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-400 via-slate-300 to-blue-600"></div>
        <div class="flex items-start justify-between">
          <div>
            <p class="text-xs sm:text-sm font-semibold uppercase tracking-wide text-slate-500 mb-1">ผู้บริหารโครงการ</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-normal uppercase">FORTH</span>
            </div>
            <div class="mt-2.5 inline-flex items-center gap-1.5 text-xs sm:text-sm text-sky-900 bg-gradient-to-r from-sky-50 via-white to-slate-100 px-3 py-1 rounded-full font-medium border border-sky-200/80 shadow-sm" id="cardTotalBadge">
              <i class="fa-solid fa-boxes-stacked text-sky-600 text-xs"></i>
              <span>รวมครุภัณฑ์ <strong class="text-sky-700 font-bold" id="statTotal">0</strong> รายการ</span>
            </div>
          </div>
          <div class="w-12 h-12 p-1 bg-gradient-to-br from-sky-50 via-white to-slate-100 rounded-xl shadow-sm border border-slate-200 flex items-center justify-center group-hover:scale-105 group-hover:shadow-md transition-all overflow-hidden">
            <img src="telecom-tower.jpg" alt="Telecom Tower & Equipment" class="w-full h-full object-contain mix-blend-multiply drop-shadow-sm rounded-lg" />
          </div>
        </div>
      </div>

      <!-- Card 2: Manufacturer / Primary Brand (HUAWEI) -->
      <div class="glass-card rounded-2xl p-5 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 relative overflow-hidden group border border-slate-200/80 hover:border-sky-300">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-400 via-slate-300 to-blue-600"></div>
        <div class="flex items-start justify-between">
          <div>
            <p class="text-xs sm:text-sm font-semibold uppercase tracking-wide text-slate-500 mb-1">ผู้ผลิต / ตราสินค้าหลัก</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-normal uppercase">HUAWEI</span>
            </div>
            <div class="mt-2.5 inline-flex items-center gap-1.5 text-xs sm:text-sm text-sky-900 bg-gradient-to-r from-sky-50 via-white to-slate-100 px-3 py-1 rounded-full font-medium border border-sky-200/80 shadow-sm">
              <i class="fa-solid fa-shield-halved text-sky-600 text-xs"></i>
              <span>อุปกรณ์ในระบบ <strong class="text-sky-700 font-bold" id="statCountHuawei">0</strong> รายการ</span>
            </div>
          </div>
          <div class="w-12 h-12 p-1 bg-gradient-to-br from-sky-50 via-white to-slate-100 rounded-xl shadow-sm border border-slate-200 flex items-center justify-center group-hover:scale-105 group-hover:shadow-md transition-all overflow-hidden">
            <img src="microwave-dish.jpg" alt="Microwave Dish" class="w-full h-full object-contain mix-blend-multiply drop-shadow-sm rounded-lg" />
          </div>
        </div>
      </div>

      <!-- Card 3: Manufacturer / Primary Brand (HYTERA) -->
      <div class="glass-card rounded-2xl p-5 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 relative overflow-hidden group border border-slate-200/80 hover:border-sky-300">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-400 via-slate-300 to-blue-600"></div>
        <div class="flex items-start justify-between">
          <div>
            <p class="text-xs sm:text-sm font-semibold uppercase tracking-wide text-slate-500 mb-1">ผู้ผลิต / ตราสินค้าหลัก</p>
            <div class="flex items-baseline gap-2">
              <span class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-normal uppercase">HYTERA</span>
            </div>
            <div class="mt-2.5 inline-flex items-center gap-1.5 text-xs sm:text-sm text-sky-900 bg-gradient-to-r from-sky-50 via-white to-slate-100 px-3 py-1 rounded-full font-medium border border-sky-200/80 shadow-sm">
              <i class="fa-solid fa-shield-halved text-sky-600 text-xs"></i>
              <span>อุปกรณ์ในระบบ <strong class="text-sky-700 font-bold" id="statCountHytera">0</strong> รายการ</span>
            </div>
          </div>
          <div class="w-12 h-12 p-1 bg-gradient-to-br from-sky-50 via-white to-slate-100 rounded-xl shadow-sm border border-slate-200 flex items-center justify-center group-hover:scale-105 group-hover:shadow-md transition-all overflow-hidden">
            <img src="pt580-plus.jpg" alt="Hytera PT580 Plus" class="w-full h-full object-contain mix-blend-multiply drop-shadow-sm rounded-lg" />
          </div>
        </div>
      </div>

    </section>


    <!-- INVENTORY TABLE / HIERARCHY SETS SECTION -->
    <section class="glass-card rounded-2xl shadow-sm border border-slate-200/90 overflow-hidden">
      
      <!-- Toolbar: Search, Filters & Hierarchy Controls -->
      <div class="p-4 sm:p-5 border-b border-slate-200/80 bg-slate-50/70">
        <!-- Row 1: Title, Description & View Mode Switcher -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 pb-3.5 border-b border-slate-200/70">
          <div class="min-w-0">
            <h2 class="text-base sm:text-lg lg:text-xl font-bold text-slate-900 flex items-center gap-2 whitespace-nowrap">
              <i class="fa-solid fa-sitemap text-sky-600 shrink-0"></i>
              <span>รายการครุภัณฑ์แบบจัดกลุ่มชุดหลักและชุดย่อย (Grouped Inventory)</span>
            </h2>
          </div>

          <!-- View Mode Switcher: Grouped vs Flat -->
          <div class="inline-flex bg-slate-200/80 p-1 rounded-xl text-xs sm:text-sm font-medium border border-slate-300/60 shrink-0 self-start lg:self-auto">
            <button onclick="setViewMode('GROUPED')" id="btnView-GROUPED" class="px-3.5 py-1.5 rounded-lg transition-all bg-white text-slate-900 shadow-sm font-semibold inline-flex items-center gap-1.5 whitespace-nowrap">
              <i class="fa-solid fa-layer-group text-sky-600 text-xs sm:text-sm"></i>
              <span class="whitespace-nowrap">มุมมองแยกชุดย่อย</span>
            </button>
            <button onclick="setViewMode('FLAT')" id="btnView-FLAT" class="px-3.5 py-1.5 rounded-lg transition-all text-slate-600 hover:text-slate-900 inline-flex items-center gap-1.5 font-semibold whitespace-nowrap">
              <i class="fa-solid fa-table-list text-xs sm:text-sm"></i>
              <span class="whitespace-nowrap">ตารางรวมทั้งหมด</span>
            </button>
          </div>
        </div>

        <!-- Row 2: Search Input & Filter Dropdown in Toolbar -->
        <div class="pt-3 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-1 max-w-2xl">
            <!-- Filter Dropdown in Toolbar: เลือกหมวดหรือหัวข้อย่อย -->
            <div id="subTopicToolbarContainer" class="relative flex-1 min-w-[220px] sm:min-w-[280px]">
              <select 
                id="subTopicToolbarSelect" 
                onchange="handleToolbarSubFilter()" 
                class="w-full appearance-none pl-8 pr-8 py-2 text-xs sm:text-sm bg-white border border-slate-300 rounded-xl font-medium text-slate-700 hover:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all shadow-sm cursor-pointer"
              >
                <option value="ALL">📂 แสดงทุกหมวดหมู่และหัวข้อย่อย</option>
              </select>
              <i class="fa-solid fa-filter absolute left-2.5 top-2.5 text-sky-500 text-xs pointer-events-none"></i>
              <i class="fa-solid fa-chevron-down absolute right-2.5 top-2.5 text-slate-400 text-[10px] pointer-events-none"></i>
            </div>

            <!-- Search Input -->
            <div class="relative flex-1 min-w-[200px]">
              <input 
                type="text" 
                id="searchInput" 
                oninput="handleSearch()" 
                placeholder="ค้นหาชื่อชุด, อุปกรณ์ย่อย, S/N..." 
                class="w-full pl-8 pr-7 py-2 text-xs sm:text-sm bg-white border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 transition-all shadow-sm font-normal"
              >
              <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-slate-400 text-xs"></i>
              <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-2.5 top-2 text-slate-400 hover:text-slate-600 p-0.5">
                <i class="fa-solid fa-circle-xmark text-xs"></i>
              </button>
            </div>
          </div>

        <!-- Filter & Group Toggle Actions Bar -->
        <div class="mt-3 flex flex-col sm:flex-row sm:items-center justify-between text-xs sm:text-sm text-slate-500 pt-2.5 border-t border-slate-200/80 gap-2">
          <div id="resultsCount">
            กำลังแสดง <span class="font-semibold text-slate-800" id="currentCount">24</span> รายการ
            <span id="groupCountText" class="ml-1 text-slate-400">(แยกเป็น <strong class="text-sky-700" id="totalGroupsCount">8</strong> ชุด)</span>
          </div>
          
          <div class="flex items-center gap-3">
            <!-- Expand / Collapse All buttons (for Grouped View) -->
            <div id="accordionControls" class="inline-flex items-center gap-1.5">
              <button onclick="expandAllGroups(true)" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs sm:text-sm transition-colors inline-flex items-center gap-1 border border-slate-200/80">
                <i class="fa-solid fa-plus text-[10px]"></i> ขยายทุกชุด
              </button>
              <button onclick="expandAllGroups(false)" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs sm:text-sm transition-colors inline-flex items-center gap-1 border border-slate-200/80">
                <i class="fa-solid fa-minus text-[10px]"></i> ย่อทุกชุด
              </button>
            </div>

            <span id="resetBtnContainer" class="hidden">
              <button onclick="resetToDefaultData()" class="text-xs sm:text-sm text-rose-600 hover:text-rose-800 font-semibold inline-flex items-center gap-1 transition-colors">
                <i class="fa-solid fa-rotate-left"></i> คืนค่าเริ่มต้น
              </button>
            </span>
          </div>
        </div>
      </div>

      <!-- VIEW 1: GROUPED HIERARCHICAL SETS VIEW (ACCORDION) -->
      <div id="groupedViewContainer" class="p-4 sm:p-5 space-y-4">
        <!-- Rendered dynamically by renderGroupedView() -->
      </div>

      <!-- VIEW 2: FLAT TABLE VIEW (ALTERNATIVE) -->
      <div id="flatViewContainer" class="overflow-x-auto hidden">
        <table class="w-full text-left border-collapse" id="equipmentTable">
          <thead>
            <tr class="bg-slate-100/90 text-slate-700 text-xs sm:text-sm font-bold uppercase tracking-wider border-b border-slate-200">
              <th class="py-3 px-4 text-center w-14 whitespace-nowrap">ลำดับ</th>
              <th class="py-3 px-4 whitespace-nowrap">ระดับ</th>
              <th class="py-3 px-4 whitespace-nowrap">รายการ / สถานีติดตั้ง</th>
              <th class="py-3 px-4 whitespace-nowrap">ยี่ห้อ</th>
              <th class="py-3 px-4 whitespace-nowrap">รุ่น (Model)</th>
              <th class="py-3 px-4 whitespace-nowrap">หมายเลขประจำเครื่อง (S/N)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm sm:text-base" id="flatTableBody">
            <!-- Dynamically populated rows -->
          </tbody>
        </table>
      </div>

      <!-- Table Footer / Summary -->
      <div class="p-3.5 bg-slate-50 border-t border-slate-200 text-xs sm:text-sm text-slate-500 flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>- สรุปยอดบัญชีรายการครุภัณฑ์</span>
        <span class="font-medium text-slate-700"> </span>
      </div>

    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-slate-950/90 backdrop-blur-md text-slate-400 text-xs py-5 border-t border-slate-800 mt-auto no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <div>
        <p class="text-white font-medium">โครงการเพิ่มประสิทธิภาพระบบโครงข่ายสื่อสารด้วยอุปกรณ์ทวนสัญญาณผ่านคลื่นความถี่สูง SHF</p>
        <p class="text-slate-500 text-xs mt-0.5">บริษัท ฟอร์ท คอร์ปอเรชั่น จำกัด (มหาชน)</p>
      </div>
      <div class="text-slate-500">
        &copy; 2026 ระบบบัญชีรายการครุภัณฑ์
      </div>
    </div>
  </footer>

  <!-- EXCEL UPLOAD MODAL -->
  <div id="excelModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/75 backdrop-blur-sm hidden fade-in">
    <div class="bg-white rounded-2xl shadow-2xl max-w-xl w-full border border-slate-200 overflow-hidden" onclick="event.stopPropagation()">
      
      <!-- Modal Header -->
      <div class="px-6 py-4 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-900 text-white flex items-center justify-between border-b border-slate-800">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-sky-500/20 text-sky-400 border border-sky-500/30 text-lg">
            <i class="fa-solid fa-file-excel"></i>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">อัปเดตข้อมูลผ่านไฟล์ Excel</h3>
            <p class="text-xs sm:text-sm text-sky-300/90">รองรับไฟล์ .xlsx, .xls และ .csv</p>
          </div>
        </div>
        <button onclick="closeExcelModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition-colors">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 space-y-4">
        
        <!-- Drag and Drop Area -->
        <div 
          id="dropzone" 
          onclick="document.getElementById('excelFileInput').click()"
          class="border-2 border-dashed border-slate-300 hover:border-sky-500 rounded-2xl p-8 text-center cursor-pointer transition-all duration-200 bg-slate-50/70 hover:bg-sky-50/30 group"
        >
          <input 
            type="file" 
            id="excelFileInput" 
            accept=".xlsx, .xls, .csv" 
            class="hidden" 
            onchange="handleFileSelect(event)"
          >
          <div class="w-14 h-14 mx-auto rounded-full bg-sky-100 text-sky-600 flex items-center justify-center text-2xl mb-3 group-hover:scale-110 transition-transform">
            <i class="fa-solid fa-cloud-arrow-up"></i>
          </div>
          <p class="font-bold text-slate-800 text-base">คลิกเพื่อเลือกไฟล์ หรือลากไฟล์มาวางที่นี่</p>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">สามารถเลือกไฟล์ Excel เช่น <span class="font-mono font-semibold text-sky-700">รายการบัญชีครุภัณฑ์ USO.xlsx</span></p>
          <span class="inline-block mt-3 px-3 py-1 bg-white border border-slate-200 text-slate-600 rounded-lg text-xs sm:text-sm font-medium shadow-sm">
            รองรับ .XLSX / .XLS / .CSV
          </span>
        </div>

        <!-- File status info -->
        <div id="fileUploadStatus" class="hidden p-3 rounded-xl text-xs sm:text-sm flex items-center justify-between border"></div>

        <!-- Guidance Box -->
        <div class="bg-sky-50/70 rounded-xl p-4 border border-sky-200/70 space-y-2 text-xs sm:text-sm">
          <p class="font-semibold text-sky-950 flex items-center gap-1.5">
            <i class="fa-solid fa-circle-info text-sky-600"></i>
            คำแนะนำโครงสร้างชุดหลักและชุดย่อยใน Excel:
          </p>
          <p class="text-slate-600 leading-relaxed">
            ระบบสามารถจัดกลุ่มชุดย่อยอัตโนมัติ โดยรายการที่ขึ้นต้นด้วยเครื่องหมาย <strong class="text-sky-700">-</strong> หรือ <strong class="text-sky-700">•</strong> หรือระบุเป็นรายการอุปกรณ์ย่อย จะถูกจัดเป็น <strong>ชุดย่อย</strong> ภายใต้ชุดหลักด้านบนให้อัตโนมัติทันที
          </p>
        </div>

        <!-- Template download link -->
        <div class="flex items-center justify-between text-xs sm:text-sm pt-1">
          <button onclick="downloadExcelTemplate()" class="text-sky-700 hover:text-sky-900 font-semibold inline-flex items-center gap-1.5 transition-colors">
            <i class="fa-solid fa-file-arrow-down text-sky-600"></i>
            ดาวน์โหลดไฟล์ตัวอย่าง Excel Template (.xlsx)
          </button>
          <span class="text-slate-400">บันทึกข้อมูลแบบเรียลไทม์</span>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
        <button onclick="resetToDefaultData()" class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold text-rose-600 hover:bg-rose-50 border border-rose-200 transition-colors">
          คืนค่าเริ่มต้น
        </button>
        <div class="flex gap-2">
          <button onclick="closeExcelModal()" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-200 hover:bg-slate-300 text-slate-700 transition-colors">
            ปิด
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- DETAIL MODAL -->
  <div id="detailModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm hidden fade-in">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full border border-slate-200 overflow-hidden" onclick="event.stopPropagation()">
      <div class="px-6 py-4 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-900 text-white flex items-center justify-between border-b border-slate-800">
        <div class="flex items-center gap-2.5">
          <div id="modalIcon" class="p-2 rounded-lg bg-sky-500/20 text-sky-400 border border-sky-500/30">
            <i class="fa-solid fa-microchip"></i>
          </div>
          <div>
            <h3 id="modalTitle" class="text-base sm:text-lg font-bold text-white">รายละเอียดครุภัณฑ์</h3>
            <p id="modalCategory" class="text-xs sm:text-sm text-slate-300">Base Station Equipment</p>
          </div>
        </div>
        <button onclick="closeModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition-colors">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <div class="p-5 space-y-3.5 text-sm sm:text-base" id="modalBody">
        <!-- Injected dynamically -->
      </div>

      <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 flex justify-end gap-2">
        <button onclick="closeModal()" class="px-4 py-1.5 rounded-xl text-xs sm:text-sm font-semibold bg-slate-200 hover:bg-slate-300 text-slate-700 transition-colors">
          ปิดหน้าต่าง
        </button>
      </div>
    </div>
  </div>

  <!-- REPORT / PRINT MODAL -->
  <div id="reportModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm hidden fade-in">
    <div class="bg-white rounded-2xl shadow-2xl max-w-xl w-full border border-slate-200 overflow-hidden max-h-[92vh] flex flex-col" onclick="event.stopPropagation()">
      <!-- Header -->
      <div class="px-6 py-4 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-900 text-white flex items-center justify-between border-b border-slate-800 shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="p-2 rounded-lg bg-sky-500/20 text-sky-400 border border-sky-500/30">
            <i class="fa-solid fa-print text-base"></i>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white">พิมพ์รายงาน / สรุปรายงาน</h3>
            <p class="text-xs sm:text-sm text-slate-400">โครงการเพิ่มประสิทธิภาพระบบโครงข่ายสื่อสาร (SHF)</p>
          </div>
        </div>
        <button onclick="closeReportModal()" class="text-slate-300 hover:text-white p-1 rounded-lg transition-colors">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <!-- Body -->
      <div class="p-5 sm:p-6 space-y-4 text-sm sm:text-base overflow-y-auto max-h-[calc(92vh-120px)]">
        <p class="text-xs sm:text-sm text-slate-500">เลือกรูปแบบการสรุปรายงานหรือการพิมพ์ PDF ตามที่ต้องการ:</p>

        <!-- Option 1: Print Specific PDF (1.1-1.2, 2.1, 3.1-3.8, 4.1-4.8, 5 รายหมู่บ้าน, 6.1-6.2) -->
        <div class="p-4 rounded-xl border-2 border-rose-500/80 bg-gradient-to-br from-rose-50/60 via-white to-slate-50 shadow-sm transition-all hover:border-rose-600">
          <div class="flex items-start gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 shadow-sm">
              <i class="fa-solid fa-file-pdf text-xl"></i>
            </div>
            <div class="flex-grow min-w-0">
              <div class="flex items-center justify-between">
                <h4 class="font-bold text-slate-900 text-sm sm:text-base text-rose-900">
                  พิมพ์เอกสาร PDF แยกตามชุดอุปกรณ์ / รายหมู่บ้าน
                </h4>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 border border-rose-200 shrink-0">แนะนำ</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
                พิมพ์ใบรายการบัญชีครุภัณฑ์ขนาด A4 พร้อมข้อมูลอุปกรณ์ และ S/N (1.1-1.2, 2.1, 3.1-3.8, 4.1-4.8, 5 รายหมู่บ้าน, 6.1-6.2)
              </p>

              <!-- Target Selector -->
              <div class="mt-3.5 space-y-2 bg-white p-3 rounded-xl border border-slate-200">
                <label class="block text-xs font-bold text-slate-700">
                  <i class="fa-solid fa-crosshairs text-rose-600 mr-1"></i>เลือกชุดอุปกรณ์ หรือ หมู่บ้านที่ต้องการพิมพ์:
                </label>
                <div class="relative">
                  <select 
                    id="pdfTargetSelect" 
                    onchange="handlePdfSelectChange()" 
                    class="w-full text-xs sm:text-sm bg-slate-50 border border-slate-300 rounded-lg pl-3 pr-8 py-2 text-slate-800 font-medium focus:ring-2 focus:ring-rose-500 focus:border-rose-500 focus:outline-none transition-all cursor-pointer"
                  >
                    <option value="">-- กำลังโหลดรายการชุดอุปกรณ์และรายชื่อหมู่บ้าน... --</option>
                  </select>
                </div>
                
                <div class="flex flex-wrap items-center gap-2 pt-1.5">
                  <button 
                    type="button"
                    onclick="handlePrintFromModal()" 
                    class="px-3.5 py-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-semibold text-xs sm:text-sm inline-flex items-center gap-1.5 shadow-sm transition-all"
                  >
                    <i class="fa-solid fa-print"></i>
                    <span>พิมพ์ PDF ชุดที่เลือก</span>
                  </button>
                  <button 
                    type="button"
                    onclick="handleBatchPrintVillages()" 
                    id="btnBatchPrintVil" 
                    class="px-3 py-2 rounded-lg bg-sky-50 hover:bg-sky-100 text-sky-800 font-semibold text-xs sm:text-sm inline-flex items-center gap-1.5 border border-sky-300 transition-all hidden"
                  >
                    <i class="fa-solid fa-layer-group text-sky-600"></i>
                    <span id="btnBatchPrintVilText">พิมพ์ทุกหมู่บ้านในจังหวัด</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Option 2: Excel Summary Report -->
        <div onclick="exportExcelSummaryReport(); closeReportModal();" class="p-4 rounded-xl border border-slate-200 bg-white hover:border-sky-500 transition-all cursor-pointer group shadow-sm hover:shadow-md">
          <div class="flex items-start gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-sky-600 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-solid fa-file-excel text-xl"></i>
            </div>
            <div class="flex-grow">
              <div class="flex items-center justify-between">
                <h4 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-sky-800">
                  สรุปรายงานเป็นไฟล์ Excel (.xlsx)
                </h4>
                <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600 border border-slate-200">.xlsx</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
                สรุปข้อมูลตามโครงสร้าง: <strong>1. รายการชุดอุปกรณ์หลัก 2. ชุดอุปกรณ์ย่อย 3. Model 4. Serial 5. จำนวน</strong>
              </p>
              <div class="mt-2 inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-sky-700 group-hover:text-sky-800">
                <i class="fa-solid fa-cloud-arrow-down"></i>
                <span>คลิกเพื่อดาวน์โหลดไฟล์ Excel (.xlsx)</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Option 3: Print Entire Page -->
        <div onclick="closeReportModal(); setTimeout(() => window.print(), 200);" class="p-4 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-400 transition-all cursor-pointer group shadow-sm hover:shadow-md">
          <div class="flex items-start gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-slate-800 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
              <i class="fa-solid fa-print text-xl"></i>
            </div>
            <div class="flex-grow">
              <h4 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-slate-950">
                พิมพ์เอกสารทั้งหน้า / บันทึกเป็น PDF ทั้งระบบ
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">
                พิมพ์ผ่านหน้าต่างสั่งพิมพ์ของเบราว์เซอร์ (Window Print Dialog) สำหรับพิมพ์ทั้งหน้าจอ
              </p>
              <div class="mt-2 inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-slate-700 group-hover:text-sky-700">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                <span>เปิดหน้าต่างพิมพ์ (Print Dialog)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-100 flex justify-between items-center text-xs sm:text-sm">
        <span class="text-slate-400">ระบบรายงานบัญชีครุภัณฑ์ FORTH</span>
        <button onclick="closeReportModal()" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-200 hover:bg-slate-300 text-slate-700 transition-colors">
          ปิดหน้าต่าง
        </button>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-3 text-xs sm:text-sm border border-slate-700">
    <div class="text-sky-400 text-base" id="toastIcon">
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <span id="toastMsg">คัดลอกข้อมูลเรียบร้อยแล้ว</span>
  </div>

